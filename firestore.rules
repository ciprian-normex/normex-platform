rules_version = '2';

service cloud.firestore {

  match /databases/{database}/documents {


    /* =====================================================
       NORMEX PLATFORM
       SECURITY FOUNDATION

       accessLevel
       = authority band

       roleCode
       = functional role

       permissions
       = organisation-level capabilities

       project membership
       = project-specific scope/capabilities

       IMPORTANT

       Numeric level alone must NOT grant unrelated
       specialist management domains.

       Plant visibility/request capability may use the
       agreed authority bands.

       Plant management itself remains permission / role
       controlled.

       Level 99 remains the deliberate platform override.
    ===================================================== */


    /* =====================================================
       AUTH / PROFILE
    ===================================================== */

    function signedIn() {

      return request.auth != null;

    }


    function currentUserPath() {

      return /databases/$(database)/documents/users/$(request.auth.uid);

    }




    function currentProfile() {
      return signedIn() && exists(currentUserPath()) ? get(currentUserPath()).data : {};
    }

    function activeActor(actor) {
      return actor.get("status", "") == "ACTIVE" &&
        validRoleLevel(actor) &&
        actor.get("organisationId", "") is string &&
        actor.organisationId.size() > 0 &&
        actor.get("permissions", null) is map;
    }

    // These map predicates are used only after activeActor at the boundary.
    function platformRole(actor) {
      return actor.get("accessLevel", 0) == 99 &&
        actor.get("roleCode", "") == "PLATFORM_ADMIN";
    }

    function organisationRole(actor) {
      return actor.get("accessLevel", 0) == 6 &&
        actor.get("roleCode", "") == "ORGANISATION_MANAGER" &&
        permissionIn(actor, "canManageUsers") &&
        permissionIn(actor, "canManageOrganisation");
    }

    function permissionIn(actor, name) {
      return actor.get("permissions", {}).get(name, false) == true;
    }

    function hasPermission(name) {
      let actor = currentProfile();
      return activeActor(actor) && permissionIn(actor, name);
    }


    function currentLevel() {
      return currentProfile().get("accessLevel", 0);
    }


    function currentOrganisationId() {
      return currentProfile().get("organisationId", "");
    }


    function currentRoleCode() {
      return currentProfile().get("roleCode", "");
    }


    function isActiveUser() {
      return activeActor(currentProfile());
    }


    function isPlatformAdmin() {
      let actor = currentProfile();
      return activeActor(actor) && platformRole(actor);
    }


    /* =====================================================
       PERMISSION MAP HELPERS
    ===================================================== */



    function canViewAllProjectsPermission() {
      return hasPermission("canViewAllProjects");
    }


    function canCreateProjectsPermission() {
      return hasPermission("canCreateProjects");
    }


    function canManageOrganisationPermission() {
      return hasPermission("canManageOrganisation");
    }


    function canManageUsersPermission() {
      return hasPermission("canManageUsers");
    }


    function canManageAssurancePermission() {
      return hasPermission("canManageAssurance");
    }


    function canViewCommercialPermission() {
      return hasPermission("canViewCommercial");
    }


    function canManageCommercialPermission() {
      return hasPermission("canManageCommercial");
    }


    function canViewPlantPermission() {
      return hasPermission("canViewPlant");
    }


    function canRequestPlantPermission() {
      return hasPermission("canRequestPlant");
    }


    function canManagePlantPermission() {
      return hasPermission("canManagePlant");
    }


    function canManageTransportPermission() {
      return hasPermission("canManageTransport");
    }


    /* =====================================================
       ORGANISATION
    ===================================================== */

    function sameOrganisation(organisationId) {
      let actor = currentProfile();
      return activeActor(actor) &&
        (platformRole(actor) || actor.organisationId == organisationId);
    }


    /* =====================================================
       PLANT ROLE / ACCESS HELPERS
    ===================================================== */

    function isPlantTransportManager() {

      return isActiveUser() &&
        currentRoleCode() ==
          "PLANT_TRANSPORT_MANAGER";

    }


    function isOrganisationManager() {
      let actor = currentProfile();
      return activeActor(actor) && organisationRole(actor);
    }


    function canViewPlant(
      organisationId
    ) {

      return isPlatformAdmin() ||

        (
          sameOrganisation(
            organisationId
          ) &&

          (
            canViewPlantPermission() ||

            canRequestPlantPermission() ||

            canManagePlantPermission() ||

            canManageTransportPermission() ||

            isPlantTransportManager() ||

            isOrganisationManager() ||

            currentLevel() >= 1
          )
        );

    }


    function canRequestPlant(
      organisationId
    ) {

      return isPlatformAdmin() ||

        (
          sameOrganisation(
            organisationId
          ) &&

          (
            canRequestPlantPermission() ||

            canManagePlantPermission() ||

            canManageTransportPermission() ||

            isPlantTransportManager() ||

            isOrganisationManager() ||

            currentLevel() >= 2
          )
        );

    }


    function canManagePlant(
      organisationId
    ) {

      return isPlatformAdmin() ||

        (
          sameOrganisation(
            organisationId
          ) &&

          (
            canManagePlantPermission() ||

            canManageOrganisationPermission() ||

            isPlantTransportManager() ||

            isOrganisationManager()
          )
        );

    }


    function canManageTransport(
      organisationId
    ) {

      return isPlatformAdmin() ||

        (
          sameOrganisation(
            organisationId
          ) &&

          (
            canManageTransportPermission() ||

            canManagePlantPermission() ||

            canManageOrganisationPermission() ||

            isPlantTransportManager() ||

            isOrganisationManager()
          )
        );

    }


    function canViewPlantCosts(
      organisationId
    ) {

      return isPlatformAdmin() ||

        (
          sameOrganisation(
            organisationId
          ) &&

          (
            canViewCommercialPermission() ||

            canManageCommercialPermission() ||

            canManagePlantPermission() ||

            canManageTransportPermission() ||

            canManageOrganisationPermission() ||

            isPlantTransportManager() ||

            isOrganisationManager()
          )
        );

    }


    /* =====================================================
       PROJECT
    ===================================================== */

    function projectPath(
      projectId
    ) {

      return /databases/$(database)/documents/projects/$(projectId);

    }


    function projectExists(
      projectId
    ) {

      return exists(
        projectPath(
          projectId
        )
      );

    }


    function projectData(projectId) {
      return signedIn() && exists(projectPath(projectId))
        ? get(projectPath(projectId)).data : {};
    }


    function projectOrganisationMatches(projectId) {
      let actor = currentProfile();
      let project = projectData(projectId);
      return activeActor(actor) && project.keys().hasAny(["organisationId"]) &&
        (platformRole(actor) || project.organisationId == actor.organisationId);
    }


    /* =====================================================
       OPTIONAL PROJECT LINK

       Plant records may be organisation-wide and not yet
       assigned to a project.

       If projectId exists, it must belong to the same
       organisation.
    ===================================================== */

    function optionalProjectValid(
      data
    ) {

      return

        !data.keys().hasAny([
          "projectId"
        ])

        ||

        data.projectId == null

        ||

        data.projectId == ""

        ||

        (
          projectExists(
            data.projectId
          ) &&

          projectData(
            data.projectId
          ).organisationId ==
            data.organisationId
        );

    }


    /* =====================================================
       PROJECT MEMBERSHIP
    ===================================================== */

    function projectMemberPath(
      projectId
    ) {

      return /databases/$(database)/documents/projects/$(projectId)/members/$(request.auth.uid);

    }




    function projectMember(projectId) {
      return signedIn() && exists(projectMemberPath(projectId))
        ? get(projectMemberPath(projectId)).data : {};
    }

    function actorMembership(actor, membership) {
      return membership.get("uid", "") == request.auth.uid &&
        membership.get("roleCode", "") == actor.get("roleCode", "") &&
        membership.get("active", false) == true;
    }

    function memberAllows(actor, projectId, name) {
      return exists(projectMemberPath(projectId)) &&
        existingMemberAllows(actor, get(projectMemberPath(projectId)).data, name);
    }

    function existingMemberAllows(actor, membership, name) {
      return actorMembership(actor, membership) && membership.get(name, false) == true;
    }


    function isProjectMember(projectId) {
      return signedIn() && actorMembership(currentProfile(), projectMember(projectId));
    }




    function projectMemberCanManage(projectId) {
      return signedIn() && memberAllows(currentProfile(), projectId, "canManageProject");
    }


    function projectMemberCanManageScopeProgress(projectId) {
      return signedIn() && memberAllows(currentProfile(), projectId, "canManageScopeProgress");
    }


    function projectMemberCanManageAssurance(projectId) {
      return signedIn() && memberAllows(currentProfile(), projectId, "canManageAssurance");
    }


    function projectMemberCanViewCommercial(projectId) {
      return signedIn() && memberAllows(currentProfile(), projectId, "canViewCommercial");
    }


    function projectMemberCanManageCommercial(projectId) {
      return signedIn() && memberAllows(currentProfile(), projectId, "canManageCommercial");
    }


    /* =====================================================
       PROJECT VISIBILITY
    ===================================================== */

    function canReadProject(projectId) {
      return canReadProjectData(projectData(projectId), projectId);
    }

    function canReadProjectData(project, projectId) {
      let actor = currentProfile();
      return activeActor(actor) &&
        (platformRole(actor) ||
          (project.get("organisationId", "") == actor.organisationId &&
            (permissionIn(actor, "canViewAllProjects") ||
              actorMembership(actor, projectMember(projectId)))));
    }


    function canReadOptionalPlantProject(
      data
    ) {

      return canViewPlant(
        data.organisationId
      )

      ||

      (
        data.keys().hasAny([
          "projectId"
        ]) &&

        data.projectId != null &&

        data.projectId != "" &&

        canReadProject(
          data.projectId
        )
      );

    }


    /* =====================================================
       PROJECT MANAGEMENT
    ===================================================== */

    function canListProject(project) {
      let actor = currentProfile();
      return activeActor(actor) && (platformRole(actor) ||
        (project.get("organisationId", "") == actor.organisationId &&
          permissionIn(actor, "canViewAllProjects")));
    }

    function canManageProject(projectId) {
      let actor = currentProfile();
      return activeActor(actor) &&
        (platformRole(actor) ||
          (projectData(projectId).get("organisationId", "") == actor.organisationId &&
            (permissionIn(actor, "canManageOrganisation") ||
              memberAllows(actor, projectId, "canManageProject"))));
    }


    /* =====================================================
       ASSURANCE
    ===================================================== */

    function canManageAssurance(projectId) {
      let actor = currentProfile();
      return activeActor(actor) &&
        (platformRole(actor) ||
          (projectData(projectId).get("organisationId", "") == actor.organisationId &&
            (permissionIn(actor, "canManageAssurance") ||
              memberAllows(actor, projectId, "canManageAssurance"))));
    }


    /* =====================================================
       COMMERCIAL
    ===================================================== */

    function canReadCommercial(projectId) {
      let actor = currentProfile();
      return activeActor(actor) &&
        (platformRole(actor) ||
          (projectData(projectId).get("organisationId", "") == actor.organisationId &&
            (permissionIn(actor, "canViewCommercial") ||
              permissionIn(actor, "canManageCommercial") ||
              memberCommercialAccess(actor, projectId))));
    }

    function memberCommercialAccess(actor, projectId) {
      let membership = projectMember(projectId);
      return actorMembership(actor, membership) &&
        (membership.get("canViewCommercial", false) == true ||
          membership.get("canManageCommercial", false) == true);
    }


    function canManageCommercial(projectId) {
      let actor = currentProfile();
      return activeActor(actor) &&
        (platformRole(actor) ||
          (projectData(projectId).get("organisationId", "") == actor.organisationId &&
            (permissionIn(actor, "canManageCommercial") ||
              memberAllows(actor, projectId, "canManageCommercial"))));
    }


    /* =====================================================
       USERS
    ===================================================== */


    /* Canonical authority and fixed delegation. Roles identify function;
       explicit permissions and membership determine capability and scope. */
    function roleLevels() {
      return {
        "WORKER": 0, "SUPERVISOR": 1, "SITE_MANAGER": 2,
        "PROJECT_MANAGER": 3, "SENIOR_PROJECT_MANAGER": 4,
        "HEALTH_SAFETY": 4.5, "SENIOR_HEALTH_SAFETY": 4.6,
        "CONTRACTS_MANAGER": 5, "PLANT_TRANSPORT_MANAGER": 5.5,
        "ORGANISATION_MANAGER": 6, "PLATFORM_ADMIN": 99
      };
    }

    function validRoleLevel(data) {
      let role = data.get("roleCode", "");
      let level = data.get("accessLevel", null);
      let levels = roleLevels();
      return role is string && level is number &&
        levels.get(role, -1) == level && level >= 0;
    }

    function permissionKeys() {
      return [
        "canViewAllProjects", "canCreateProjects",
        "canManageUsers", "canManageOrganisation",
        "canManageAssurance", "canViewCommercial", "canManageCommercial",
        "canViewPlant", "canRequestPlant", "canManagePlant", "canManageTransport"
      ];
    }

    function validPermissions(p) {
      return p is map && p.keys().hasOnly(permissionKeys()) &&
        p.values().hasOnly([true, false]);
    }

    function validCanonicalProfile(data) {
      return validRoleLevel(data) &&
        data.get("organisationId", "") is string &&
        data.organisationId.size() > 0 &&
        data.get("status", "") in ["ACTIVE", "INACTIVE"] &&
        validPermissions(data.get("permissions", null));
    }

    function operationalRoles() {
      return ["WORKER", "SUPERVISOR", "SITE_MANAGER", "PROJECT_MANAGER",
        "SENIOR_PROJECT_MANAGER", "HEALTH_SAFETY", "SENIOR_HEALTH_SAFETY",
        "CONTRACTS_MANAGER", "PLANT_TRANSPORT_MANAGER"];
    }

    function eligibleTenantIdentity(data) {
      return data.get("roleCode", "") in operationalRoles() &&
        data.get("permissions", null) is map &&
        data.permissions.get("canManageUsers", false) == false &&
        data.permissions.get("canManageOrganisation", false) == false;
    }

    function tenantPermissionCeiling(data) {
      let p = data.permissions;
      let role = data.roleCode;
      return
        (!p.get("canViewAllProjects", false) ||
          role in ["SENIOR_PROJECT_MANAGER", "SENIOR_HEALTH_SAFETY",
            "CONTRACTS_MANAGER", "PLANT_TRANSPORT_MANAGER"]) &&
        (!p.get("canCreateProjects", false) || role == "CONTRACTS_MANAGER") &&
        (!p.get("canManageAssurance", false) || role == "SENIOR_HEALTH_SAFETY") &&
        (!p.get("canViewCommercial", false) || role == "CONTRACTS_MANAGER") &&
        (!p.get("canManageCommercial", false) ||
          (role == "CONTRACTS_MANAGER" && p.get("canViewCommercial", false))) &&
        (!p.get("canViewPlant", false) || role == "PLANT_TRANSPORT_MANAGER") &&
        (!p.get("canRequestPlant", false) ||
          (role == "PLANT_TRANSPORT_MANAGER" && p.get("canViewPlant", false))) &&
        (!p.get("canManagePlant", false) ||
          (role == "PLANT_TRANSPORT_MANAGER" && p.get("canViewPlant", false))) &&
        (!p.get("canManageTransport", false) ||
          (role == "PLANT_TRANSPORT_MANAGER" && p.get("canViewPlant", false)));
    }

    function tenantAuthorityStable(actor) {
      return getAfter(currentUserPath()).data.diff(actor)
        .affectedKeys().hasOnly(["displayName"]);
    }


    function safeDisplayName(data) {
      return data.get("displayName", null) is string &&
        data.displayName.size() > 0 && data.displayName.size() <= 120;
    }

    function newProfileShape(data, uid) {
      return data.keys().hasOnly([
        "organisationId", "status", "accessLevel", "roleCode", "permissions",
        "displayName", "email", "uid",
        "createdAt", "createdByUid", "updatedAt", "updatedByUid"
      ]) && safeDisplayName(data) &&
        data.get("uid", uid) == uid && data.get("email", "") is string;
    }

    function canCreateProfile(uid) {
      let actor = currentProfile();
      let next = request.resource.data;
      return activeActor(actor) && newProfileShape(next, uid) &&
        validCanonicalProfile(next) &&
        (platformRole(actor) ||
          (organisationRole(actor) && uid != request.auth.uid &&
            next.organisationId == actor.organisationId &&
            eligibleTenantIdentity(next) && tenantPermissionCeiling(next) &&
            tenantAuthorityStable(actor)));
    }

    function canUpdateProfile(uid) {
      let actor = currentProfile();
      let next = request.resource.data;
      let changed = next.diff(resource.data).affectedKeys();
      return activeActor(actor) &&
        ((uid == request.auth.uid && changed.hasOnly(["displayName"]) &&
            safeDisplayName(next)) ||
          (platformRole(actor) && validCanonicalProfile(next)) ||
          (organisationRole(actor) && uid != request.auth.uid &&
            tenantProfileUpdate(actor, next, changed)));
    }

    function tenantProfileUpdate(actor, next, changed) {
      let before = resource.data;
      let authorityChanged = changed.hasAny(["status", "accessLevel", "roleCode", "permissions"]);
      return before.get("organisationId", "") == actor.organisationId &&
        next.get("organisationId", "") == before.organisationId &&
        changed.hasOnly(["displayName", "status", "accessLevel", "roleCode",
          "permissions", "updatedAt", "updatedByUid"]) &&
        validRoleLevel(before) && eligibleTenantIdentity(before) &&
        (!changed.hasAny(["displayName"]) || safeDisplayName(next)) &&
        (!authorityChanged ||
          (validCanonicalProfile(before) && validCanonicalProfile(next) &&
            eligibleTenantIdentity(next) && tenantPermissionCeiling(next))) &&
        tenantAuthorityStable(actor);
    }

    function canReadProfile(data) {
      let actor = currentProfile();
      return activeActor(actor) &&
        (platformRole(actor) ||
          (data.get("organisationId", "") == actor.organisationId &&
            (permissionIn(actor, "canManageUsers") ||
              permissionIn(actor, "canManageAssurance"))));
    }


    function memberUserPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }


    function membershipShape(data, uid, targetRole) {
      return data.keys().hasAll(["uid", "roleCode", "active"]) &&
        data.keys().hasOnly([
          "uid", "roleCode", "active", "assignedFrom", "assignedUntil",
          "canManageProject", "canUpdateOperations", "canManageScopeProgress",
          "canManageAssurance", "canViewCommercial", "canManageCommercial",
          "createdAt", "createdByUid", "updatedAt", "updatedByUid"
        ]) &&
        data.uid == uid && data.roleCode == targetRole && data.active is bool &&
        [data.get("canManageProject", false), data.get("canUpdateOperations", false), data.get("canManageScopeProgress", false), data.get("canManageAssurance", false), data.get("canViewCommercial", false), data.get("canManageCommercial", false)].hasOnly([true, false]) &&
        (data.get("assignedFrom", null) == null || data.assignedFrom is timestamp) &&
        (data.get("assignedUntil", null) == null || data.assignedUntil is timestamp);
    }

    function membershipCeiling(data) {
      let role = data.roleCode;
      let projectRoles = ["PROJECT_MANAGER", "SENIOR_PROJECT_MANAGER", "CONTRACTS_MANAGER"];
      let operational = role in ["SUPERVISOR", "SITE_MANAGER",
        "PROJECT_MANAGER", "SENIOR_PROJECT_MANAGER", "CONTRACTS_MANAGER"];
      return
        (!data.get("canManageProject", false) || role in projectRoles) &&
        (!data.get("canUpdateOperations", false) || operational) &&
        (!data.get("canManageScopeProgress", false) || operational) &&
        (!data.get("canManageAssurance", false) ||
          role in ["HEALTH_SAFETY", "SENIOR_HEALTH_SAFETY"]) &&
        (!data.get("canViewCommercial", false) || role in projectRoles) &&
        (!data.get("canManageCommercial", false) ||
          (role in projectRoles && data.get("canViewCommercial", false)));
    }

    function ordinaryMembership(data) {
      return data.roleCode in ["WORKER", "SUPERVISOR", "SITE_MANAGER",
          "PROJECT_MANAGER", "SENIOR_PROJECT_MANAGER", "CONTRACTS_MANAGER"] &&
        data.get("canManageProject", false) == false &&
        data.get("canManageAssurance", false) == false &&
        data.get("canViewCommercial", false) == false &&
        data.get("canManageCommercial", false) == false;
    }

    function membershipManager(actor, projectId) {
      return actor.roleCode in ["PROJECT_MANAGER", "SENIOR_PROJECT_MANAGER", "CONTRACTS_MANAGER"] &&
        memberAllows(actor, projectId, "canManageProject");
    }

    function canWriteMembership(projectId, uid) {
      return signedIn() && exists(memberUserPath(uid)) && exists(projectPath(projectId)) &&
        canWriteExistingMembership(projectId, uid);
    }

    function canWriteExistingMembership(projectId, uid) {
      let actor = currentProfile();
      let target = get(memberUserPath(uid)).data;
      let project = projectData(projectId);
      let next = request.resource.data;
      return activeActor(actor) && validCanonicalProfile(target) &&
        membershipShape(next, uid, target.roleCode) &&
        target.organisationId == project.get("organisationId", "") &&
        (platformRole(actor)
          ? getAfter(memberUserPath(uid)).data.organisationId ==
              getAfter(projectPath(projectId)).data.organisationId
          : tenantMemberWrite(actor, target, projectId, uid));
    }

    function tenantMemberWrite(actor, target, projectId, uid) {
      let next = request.resource.data;
      return eligibleTenantIdentity(target) && target.status == "ACTIVE" &&
        target.organisationId == actor.organisationId &&
        membershipCeiling(next) &&
        (organisationRole(actor) ||
          (membershipManager(actor, projectId) && ordinaryMembership(next) &&
            (request.method == "create" ||
              (membershipShape(resource.data, uid, target.roleCode) &&
                ordinaryMembership(resource.data))))) &&
        tenantAuthorityStable(actor) &&
        getAfter(memberUserPath(uid)).data.diff(target).affectedKeys().hasOnly(["displayName"]) &&
        getAfter(projectPath(projectId)).data.organisationId == target.organisationId;
    }

    function canDeleteMembership(projectId, uid) {
      let actor = currentProfile();
      return activeActor(actor) &&
        (platformRole(actor) ||
          (exists(memberUserPath(uid)) && exists(projectPath(projectId)) &&
            tenantMemberDelete(actor, projectId, uid)));
    }

    function tenantMemberDelete(actor, projectId, uid) {
      let target = get(memberUserPath(uid)).data;
      return validCanonicalProfile(target) && eligibleTenantIdentity(target) &&
        target.organisationId == actor.organisationId &&
        projectData(projectId).get("organisationId", "") == actor.organisationId &&
        (organisationRole(actor) ||
          (membershipManager(actor, projectId) &&
            membershipShape(resource.data, uid, target.roleCode) &&
            ordinaryMembership(resource.data))) &&
        tenantAuthorityStable(actor);
    }

    match /users/{userId} {
      allow get: if signedIn() &&
        (request.auth.uid == userId || canReadProfile(resource.data));
      allow list: if canReadProfile(resource.data);
      allow create: if canCreateProfile(userId);
      allow update: if canUpdateProfile(userId);
      allow delete: if isPlatformAdmin();
    }


    /* =====================================================
       ORGANISATIONS
    ===================================================== */

    match /organisations/{organisationId} {


      allow read: if
        sameOrganisation(
          organisationId
        );


      allow create:
        if isPlatformAdmin();


      allow update: if
        isPlatformAdmin() ||

        (
          sameOrganisation(
            organisationId
          ) &&

          canManageOrganisationPermission()
        );


      allow delete:
        if isPlatformAdmin();

    }


    /* =====================================================
       SITES
    ===================================================== */

    match /sites/{siteId} {


      allow read: if
        isActiveUser() &&
        sameOrganisation(
          resource.data.organisationId
        );


      allow create: if
        (
          isPlatformAdmin() ||

          canManageOrganisationPermission()
        ) &&

        sameOrganisation(
          request.resource.data.organisationId
        );


      allow update: if
        (
          isPlatformAdmin() ||

          canManageOrganisationPermission()
        ) &&

        sameOrganisation(
          resource.data.organisationId
        ) &&

        request.resource.data.organisationId ==
          resource.data.organisationId;


      allow delete:
        if isPlatformAdmin();

    }


    /* =====================================================
       PROJECTS
    ===================================================== */

    match /projects/{projectId} {


      allow get: if canReadProjectData(resource.data, projectId);
      allow list: if canListProject(resource.data);

      allow create: if
        (
          isPlatformAdmin() ||

          canCreateProjectsPermission() ||

          canManageOrganisationPermission()
        ) &&

        sameOrganisation(
          request.resource.data.organisationId
        ) &&

        request.resource.data.keys().hasAll([
          "organisationId",
          "projectCode",
          "name",
          "status",
          "rolesOnProject",
          "createdByUid",
          "createdAt",
          "updatedByUid",
          "updatedAt"
        ]) &&

        request.resource.data.name is string &&

        request.resource.data.projectCode is string &&

        request.resource.data.rolesOnProject is list &&

        request.resource.data.status in [
          "PRE_CONSTRUCTION",
          "LIVE",
          "ON_HOLD",
          "COMPLETE"
        ] &&

        request.resource.data.createdByUid ==
          request.auth.uid &&

        request.resource.data.updatedByUid ==
          request.auth.uid;


      allow update: if
        canManageProject(
          projectId
        ) &&

        request.resource.data.organisationId ==
          resource.data.organisationId &&

        request.resource.data.createdByUid ==
          resource.data.createdByUid &&

        request.resource.data.createdAt ==
          resource.data.createdAt;


      allow delete:
        if isPlatformAdmin();


      /* ===================================================
         MEMBERS
      =================================================== */

      match /members/{memberUid} {


        allow read: if
          canReadProject(
            projectId
          );


        allow create, update: if canWriteMembership(projectId, memberUid);

        allow delete: if canDeleteMembership(projectId, memberUid);

      }


      /* ===================================================
         ACTIVITY
      =================================================== */

      match /activity/{activityId} {


        allow read: if
          canReadProject(
            projectId
          );


        allow create: if
          canReadProject(
            projectId
          ) &&

          request.resource.data.projectId ==
            projectId &&

          request.resource.data.organisationId ==
            projectData(
              projectId
            ).organisationId &&

          request.resource.data.createdByUid ==
            request.auth.uid;


        allow update, delete:
          if false;

      }

    }


    /* =====================================================
       PROJECT PHASES
    ===================================================== */

    match /projectPhases/{phaseId} {


      allow read: if
        canReadProject(
          resource.data.projectId
        );


      allow create: if
        canManageProject(
          request.resource.data.projectId
        ) &&

        request.resource.data.organisationId ==
          projectData(
            request.resource.data.projectId
          ).organisationId &&

        request.resource.data.createdByUid ==
          request.auth.uid;


      allow update: if
        canManageProject(
          resource.data.projectId
        ) &&

        request.resource.data.projectId ==
          resource.data.projectId &&

        request.resource.data.organisationId ==
          resource.data.organisationId &&

        request.resource.data.createdByUid ==
          resource.data.createdByUid &&

        request.resource.data.createdAt ==
          resource.data.createdAt;


      allow delete:
        if isPlatformAdmin();

    }


    /* =====================================================
       PROJECT SCOPES
    ===================================================== */

    match /projectScopes/{scopeId} {


      allow read: if
        canReadProject(
          resource.data.projectId
        );


      allow create: if
        canManageProject(
          request.resource.data.projectId
        ) &&

        request.resource.data.organisationId ==
          projectData(
            request.resource.data.projectId
          ).organisationId &&

        request.resource.data.createdByUid ==
          request.auth.uid;


      allow update: if

        (
          canManageProject(
            resource.data.projectId
          ) &&

          request.resource.data.projectId ==
            resource.data.projectId &&

          request.resource.data.organisationId ==
            resource.data.organisationId &&

          request.resource.data.createdByUid ==
            resource.data.createdByUid &&

          request.resource.data.createdAt ==
            resource.data.createdAt
        )

        ||

        (
          isActiveUser() &&

          projectOrganisationMatches(
            resource.data.projectId
          ) &&

          projectMemberCanManageScopeProgress(
            resource.data.projectId
          ) &&

          request.resource.data.diff(
            resource.data
          ).affectedKeys().hasOnly([
            "status",
            "actualStart",
            "actualFinish",
            "updatedByUid",
            "updatedAt"
          ]) &&

          request.resource.data.updatedByUid ==
            request.auth.uid
        );


      allow delete:
        if isPlatformAdmin();

    }


    /* =====================================================
       COMMERCIAL RECORDS
    ===================================================== */

    match /commercialRecords/{recordId} {


      allow read: if
        canReadCommercial(
          resource.data.projectId
        );


      allow create: if
        canManageCommercial(
          request.resource.data.projectId
        ) &&

        request.resource.data.organisationId ==
          projectData(
            request.resource.data.projectId
          ).organisationId &&

        request.resource.data.type in [
          "QUOTATION",
          "RFQ",
          "SUPPLIER_RFQ",
          "VARIATION_QUOTE",
          "VARIATION",
          "PURCHASE_ORDER",
          "OTHER"
        ] &&

        request.resource.data.createdByUid ==
          request.auth.uid;


      allow update: if
        canManageCommercial(
          resource.data.projectId
        ) &&

        request.resource.data.projectId ==
          resource.data.projectId &&

        request.resource.data.organisationId ==
          resource.data.organisationId &&

        request.resource.data.createdByUid ==
          resource.data.createdByUid &&

        request.resource.data.createdAt ==
          resource.data.createdAt;


      allow delete:
        if isPlatformAdmin();

    }


    /* =====================================================
       PLANT ASSETS

       Master plant identity.

       Read:
       Plant viewers.

       Manage:
       Plant / Transport Manager
       Organisation Manager
       explicit permission
       Level 99
    ===================================================== */

    match /plantAssets/{plantId} {


      allow read: if
        canViewPlant(
          resource.data.organisationId
        );


      allow create: if
        canManagePlant(
          request.resource.data.organisationId
        ) &&

        request.resource.data.organisationId ==
          currentOrganisationId() &&

        request.resource.data.keys().hasAll([
          "organisationId",
          "plantId",
          "plantReference",
          "plantType",
          "ownershipType",
          "status",
          "active",
          "createdByUid",
          "createdAt",
          "updatedByUid",
          "updatedAt"
        ]) &&

        request.resource.data.plantId ==
          plantId &&

        request.resource.data.plantReference ==
          plantId &&

        request.resource.data.createdByUid ==
          request.auth.uid &&

        request.resource.data.updatedByUid ==
          request.auth.uid;


      allow update: if
        canManagePlant(
          resource.data.organisationId
        ) &&

        request.resource.data.organisationId ==
          resource.data.organisationId &&

        request.resource.data.plantId ==
          resource.data.plantId &&

        request.resource.data.plantReference ==
          resource.data.plantReference &&

        request.resource.data.createdByUid ==
          resource.data.createdByUid &&

        request.resource.data.createdAt ==
          resource.data.createdAt;


      allow delete:
        if isPlatformAdmin();

    }


    /* =====================================================
       PLANT COUNTERS

       Used to allocate readable Plant IDs.

       Example:
       colemans_HRE
    ===================================================== */

    match /plantCounters/{counterId} {


      allow read: if
        canManagePlant(
          resource.data.organisationId
        );


      allow create: if
        canManagePlant(
          request.resource.data.organisationId
        ) &&

        request.resource.data.organisationId ==
          currentOrganisationId() &&

        request.resource.data.nextNumber is number;


      allow update: if
        canManagePlant(
          resource.data.organisationId
        ) &&

        request.resource.data.organisationId ==
          resource.data.organisationId &&

        request.resource.data.nextNumber is number;


      allow delete:
        if isPlatformAdmin();

    }


    /* =====================================================
       PLANT HIRE RECORDS

       Contains commercially sensitive rates / charges.

       Read is deliberately narrower than general Fleet read.
    ===================================================== */

    match /plantHireRecords/{hireId} {


      allow read: if
        canViewPlantCosts(
          resource.data.organisationId
        );


      allow create: if
        canManagePlant(
          request.resource.data.organisationId
        ) &&

        request.resource.data.organisationId ==
          currentOrganisationId() &&

        request.resource.data.keys().hasAll([
          "organisationId",
          "plantId",
          "plantReference",
          "status",
          "createdByUid",
          "createdAt",
          "updatedByUid",
          "updatedAt"
        ]) &&

        request.resource.data.createdByUid ==
          request.auth.uid;


      allow update: if
        canManagePlant(
          resource.data.organisationId
        ) &&

        request.resource.data.organisationId ==
          resource.data.organisationId &&

        request.resource.data.plantId ==
          resource.data.plantId &&

        request.resource.data.plantReference ==
          resource.data.plantReference &&

        request.resource.data.createdByUid ==
          resource.data.createdByUid &&

        request.resource.data.createdAt ==
          resource.data.createdAt;


      allow delete:
        if isPlatformAdmin();

    }


    /* =====================================================
       PLANT ASSIGNMENTS

       Project commitment / deployment truth.
    ===================================================== */

    match /plantAssignments/{assignmentId} {


      allow read: if
        canReadOptionalPlantProject(
          resource.data
        );


      allow create: if
        canManagePlant(
          request.resource.data.organisationId
        ) &&

        optionalProjectValid(
          request.resource.data
        ) &&

        request.resource.data.createdByUid ==
          request.auth.uid;


      allow update: if
        canManagePlant(
          resource.data.organisationId
        ) &&

        request.resource.data.organisationId ==
          resource.data.organisationId &&

        request.resource.data.plantId ==
          resource.data.plantId &&

        optionalProjectValid(
          request.resource.data
        ) &&

        request.resource.data.createdByUid ==
          resource.data.createdByUid &&

        request.resource.data.createdAt ==
          resource.data.createdAt;


      allow delete:
        if isPlatformAdmin();

    }


    /* =====================================================
       PLANT MOVEMENTS

       Physical plant logistics / location evidence.
    ===================================================== */

    match /plantMovements/{movementId} {


      allow read: if
        canReadOptionalPlantProject(
          resource.data
        );


      allow create: if
        canManageTransport(
          request.resource.data.organisationId
        ) &&

        optionalProjectValid(
          request.resource.data
        ) &&

        request.resource.data.createdByUid ==
          request.auth.uid;


      allow update: if
        canManageTransport(
          resource.data.organisationId
        ) &&

        request.resource.data.organisationId ==
          resource.data.organisationId &&

        request.resource.data.plantId ==
          resource.data.plantId &&

        optionalProjectValid(
          request.resource.data
        ) &&

        request.resource.data.createdByUid ==
          resource.data.createdByUid &&

        request.resource.data.createdAt ==
          resource.data.createdAt;


      allow delete:
        if isPlatformAdmin();

    }


    /* =====================================================
       PLANT REQUESTS

       Incoming demand:
       PLANT
       REPAIR
       TRANSPORT
       MATERIAL_TRANSPORT
       REPLACEMENT
       COLLECTION
       OTHER

       L2+ / authorised users can submit.

       Plant management owns fulfilment / status control.
    ===================================================== */

    match /plantRequests/{requestId} {


      allow read: if

        canManagePlant(
          resource.data.organisationId
        )

        ||

        canManageTransport(
          resource.data.organisationId
        )

        ||

        (
          signedIn() &&

          sameOrganisation(
            resource.data.organisationId
          ) &&

          resource.data.createdByUid ==
            request.auth.uid
        )

        ||

        (
          resource.data.keys().hasAny([
            "projectId"
          ]) &&

          resource.data.projectId != null &&

          resource.data.projectId != "" &&

          canReadProject(
            resource.data.projectId
          )
        );


      allow create: if
        canRequestPlant(
          request.resource.data.organisationId
        ) &&

        request.resource.data.organisationId ==
          currentOrganisationId() &&

        optionalProjectValid(
          request.resource.data
        ) &&

        request.resource.data.createdByUid ==
          request.auth.uid &&

        request.resource.data.requestType in [
          "PLANT",
          "REPAIR",
          "TRANSPORT",
          "MATERIAL_TRANSPORT",
          "REPLACEMENT",
          "COLLECTION",
          "OTHER"
        ];


      allow update: if
        (
          canManagePlant(
            resource.data.organisationId
          )

          ||

          canManageTransport(
            resource.data.organisationId
          )
        ) &&

        request.resource.data.organisationId ==
          resource.data.organisationId &&

        request.resource.data.createdByUid ==
          resource.data.createdByUid &&

        request.resource.data.createdAt ==
          resource.data.createdAt &&

        optionalProjectValid(
          request.resource.data
        );


      allow delete:
        if isPlatformAdmin();

    }


    /* =====================================================
       PLANT ISSUES

       Operational exception-management layer.

       Examples:
       sourcing blocker
       breakdown delay
       part delay
       transport blocker
       replacement problem
       idle hire exposure
    ===================================================== */

    match /plantIssues/{issueId} {


      allow read: if
        canReadOptionalPlantProject(
          resource.data
        );


      allow create: if
        (
          canManagePlant(
            request.resource.data.organisationId
          )

          ||

          canManageTransport(
            request.resource.data.organisationId
          )
        ) &&

        optionalProjectValid(
          request.resource.data
        ) &&

        request.resource.data.createdByUid ==
          request.auth.uid;


      allow update: if
        (
          canManagePlant(
            resource.data.organisationId
          )

          ||

          canManageTransport(
            resource.data.organisationId
          )
        ) &&

        request.resource.data.organisationId ==
          resource.data.organisationId &&

        request.resource.data.createdByUid ==
          resource.data.createdByUid &&

        request.resource.data.createdAt ==
          resource.data.createdAt &&

        optionalProjectValid(
          request.resource.data
        );


      allow delete:
        if isPlatformAdmin();

    }


    /* =====================================================
       PLANT INSPECTIONS

       Operational inspection evidence.

       Project users may create inspection records against
       plant relevant to their project.

       Plant managers retain organisation-wide visibility.
    ===================================================== */

    match /plantInspections/{inspectionId} {


      allow read: if
        canReadOptionalPlantProject(
          resource.data
        );


      allow create: if
        isActiveUser() &&

        sameOrganisation(
          request.resource.data.organisationId
        ) &&

        optionalProjectValid(
          request.resource.data
        ) &&

        request.resource.data.createdByUid ==
          request.auth.uid &&

        (
          canViewPlant(
            request.resource.data.organisationId
          )

          ||

          (
            request.resource.data.keys().hasAny([
              "projectId"
            ]) &&

            request.resource.data.projectId != null &&

            request.resource.data.projectId != "" &&

            canReadProject(
              request.resource.data.projectId
            )
          )
        );


      allow update: if
        canManagePlant(
          resource.data.organisationId
        ) &&

        request.resource.data.organisationId ==
          resource.data.organisationId &&

        request.resource.data.plantId ==
          resource.data.plantId &&

        request.resource.data.createdByUid ==
          resource.data.createdByUid &&

        request.resource.data.createdAt ==
          resource.data.createdAt;


      allow delete:
        if isPlatformAdmin();

    }


    /* =====================================================
       PLANT DEFECTS

       Operational users may report defects.

       Plant management controls repair lifecycle.
    ===================================================== */

    match /plantDefects/{defectId} {


      allow read: if
        canReadOptionalPlantProject(
          resource.data
        );


      allow create: if
        isActiveUser() &&

        sameOrganisation(
          request.resource.data.organisationId
        ) &&

        optionalProjectValid(
          request.resource.data
        ) &&

        request.resource.data.createdByUid ==
          request.auth.uid &&

        (
          canViewPlant(
            request.resource.data.organisationId
          )

          ||

          (
            request.resource.data.keys().hasAny([
              "projectId"
            ]) &&

            request.resource.data.projectId != null &&

            request.resource.data.projectId != "" &&

            canReadProject(
              request.resource.data.projectId
            )
          )
        );


      allow update: if
        canManagePlant(
          resource.data.organisationId
        ) &&

        request.resource.data.organisationId ==
          resource.data.organisationId &&

        request.resource.data.plantId ==
          resource.data.plantId &&

        request.resource.data.createdByUid ==
          resource.data.createdByUid &&

        request.resource.data.createdAt ==
          resource.data.createdAt;


      allow delete:
        if isPlatformAdmin();

    }


    /* =====================================================
       PLANT MAINTENANCE
    ===================================================== */

    match /plantMaintenance/{maintenanceId} {


      allow read: if
        canViewPlant(
          resource.data.organisationId
        );


      allow create: if
        canManagePlant(
          request.resource.data.organisationId
        ) &&

        request.resource.data.organisationId ==
          currentOrganisationId() &&

        optionalProjectValid(
          request.resource.data
        ) &&

        request.resource.data.createdByUid ==
          request.auth.uid;


      allow update: if
        canManagePlant(
          resource.data.organisationId
        ) &&

        request.resource.data.organisationId ==
          resource.data.organisationId &&

        request.resource.data.plantId ==
          resource.data.plantId &&

        request.resource.data.createdByUid ==
          resource.data.createdByUid &&

        request.resource.data.createdAt ==
          resource.data.createdAt;


      allow delete:
        if isPlatformAdmin();

    }


    /* =====================================================
       PLANT SUPPLIERS
    ===================================================== */

    match /plantSuppliers/{supplierId} {


      allow read: if
        canViewPlant(
          resource.data.organisationId
        );


      allow create: if
        canManagePlant(
          request.resource.data.organisationId
        ) &&

        request.resource.data.organisationId ==
          currentOrganisationId() &&

        request.resource.data.createdByUid ==
          request.auth.uid;


      allow update: if
        canManagePlant(
          resource.data.organisationId
        ) &&

        request.resource.data.organisationId ==
          resource.data.organisationId &&

        request.resource.data.createdByUid ==
          resource.data.createdByUid &&

        request.resource.data.createdAt ==
          resource.data.createdAt;


      allow delete:
        if isPlatformAdmin();

    }


    /* =====================================================
       DOCUMENT HELPERS
    ===================================================== */

    function isPlantDocument(
      data
    ) {

      return data.keys().hasAny([
        "entityType"
      ]) &&

      data.keys().hasAny([
        "entityId"
      ]) &&

      data.entityType ==
        "PLANT";

    }


    function canReadPlantDocument(
      data
    ) {

      return isPlantDocument(
        data
      ) &&

      (
        data.category ==
          "COMMERCIAL"
          ? canViewPlantCosts(
              data.organisationId
            )
          : canViewPlant(
              data.organisationId
            )
      );

    }


    function canCreatePlantDocument(
      data
    ) {

      return isPlantDocument(
        data
      ) &&

      sameOrganisation(
        data.organisationId
      ) &&

      (
        canManagePlant(
          data.organisationId
        )

        ||

        (
          data.category ==
            "ASSURANCE" &&

          canManageAssurancePermission()
        )
      );

    }


    function canUpdatePlantDocument(
      data
    ) {

      return isPlantDocument(
        data
      ) &&

      sameOrganisation(
        data.organisationId
      ) &&

      (
        canManagePlant(
          data.organisationId
        )

        ||

        (
          data.category ==
            "ASSURANCE" &&

          canManageAssurancePermission()
        )
      );

    }


    /* =====================================================
       DOCUMENTS

       Supports BOTH:

       1. Project documents
       2. Plant-linked documents

       Plant records use:
       entityType = "PLANT"
       entityId   = Plant ID
    ===================================================== */

match /documents/{documentId} {


  allow read: if

    isPlatformAdmin()

    ||

    canReadPlantDocument(
      resource.data
    )

    ||

        (
          !isPlantDocument(
            resource.data
          ) &&

          resource.data.category ==
            "COMMERCIAL" &&

          canReadCommercial(
            resource.data.projectId
          )
        )

        ||

        (
          !isPlantDocument(
            resource.data
          ) &&

          resource.data.category !=
            "COMMERCIAL" &&

          canReadProject(
            resource.data.projectId
          )
        );


      allow create: if

        (
          isPlantDocument(
            request.resource.data
          ) &&

          request.resource.data.keys().hasAll([
            "organisationId",
            "entityType",
            "entityId",
            "category",
            "documentType",
            "title",
            "storagePath",
            "fileName",
            "mimeType",
            "fileSize",
            "uploadedByUid",
            "uploadedAt"
          ]) &&

          request.resource.data.uploadedByUid ==
            request.auth.uid &&

          request.resource.data.category in [
            "PROJECT",
            "SCOPE",
            "COMMERCIAL",
            "ASSURANCE",
            "DRAWING",
            "PROGRAMME",
            "GENERAL",
            "PLANT",
            "HIRE",
            "CONDITION",
            "REPAIR",
            "TRANSPORT",
            "MANUAL"
          ] &&

          canCreatePlantDocument(
            request.resource.data
          )
        )

        ||

        (
          !isPlantDocument(
            request.resource.data
          ) &&

          request.resource.data.keys().hasAll([
            "organisationId",
            "projectId",
            "category",
            "documentType",
            "title",
            "storagePath",
            "fileName",
            "mimeType",
            "fileSize",
            "uploadedByUid",
            "uploadedAt"
          ]) &&

          request.resource.data.organisationId ==
            projectData(
              request.resource.data.projectId
            ).organisationId &&

          request.resource.data.uploadedByUid ==
            request.auth.uid &&

          request.resource.data.category in [
            "PROJECT",
            "SCOPE",
            "COMMERCIAL",
            "ASSURANCE",
            "DRAWING",
            "PROGRAMME",
            "GENERAL"
          ] &&

          (
            (
              request.resource.data.category ==
                "COMMERCIAL" &&

              canManageCommercial(
                request.resource.data.projectId
              )
            )

            ||

            (
              request.resource.data.category ==
                "ASSURANCE" &&

              canManageAssurance(
                request.resource.data.projectId
              )
            )

            ||

            (
              request.resource.data.category !=
                "COMMERCIAL" &&

              request.resource.data.category !=
                "ASSURANCE" &&

              canManageProject(
                request.resource.data.projectId
              )
            )
          )
        );


      allow update: if

        (
          isPlantDocument(
            resource.data
          ) &&

          canUpdatePlantDocument(
            resource.data
          ) &&

          request.resource.data.organisationId ==
            resource.data.organisationId &&

          request.resource.data.entityType ==
            resource.data.entityType &&

          request.resource.data.entityId ==
            resource.data.entityId &&

          request.resource.data.storagePath ==
            resource.data.storagePath &&

          request.resource.data.fileName ==
            resource.data.fileName &&

          request.resource.data.mimeType ==
            resource.data.mimeType &&

          request.resource.data.fileSize ==
            resource.data.fileSize &&

          request.resource.data.uploadedByUid ==
            resource.data.uploadedByUid &&

          request.resource.data.uploadedAt ==
            resource.data.uploadedAt
        )

        ||

        (
          !isPlantDocument(
            resource.data
          ) &&

          (
            (
              resource.data.category ==
                "COMMERCIAL" &&

              canManageCommercial(
                resource.data.projectId
              )
            )

            ||

            (
              resource.data.category ==
                "ASSURANCE" &&

              canManageAssurance(
                resource.data.projectId
              )
            )

            ||

            (
              resource.data.category !=
                "COMMERCIAL" &&

              resource.data.category !=
                "ASSURANCE" &&

              canManageProject(
                resource.data.projectId
              )
            )
          ) &&

          request.resource.data.organisationId ==
            resource.data.organisationId &&

          request.resource.data.projectId ==
            resource.data.projectId &&

          request.resource.data.category ==
            resource.data.category &&

          request.resource.data.storagePath ==
            resource.data.storagePath &&

          request.resource.data.fileName ==
            resource.data.fileName &&

          request.resource.data.mimeType ==
            resource.data.mimeType &&

          request.resource.data.fileSize ==
            resource.data.fileSize &&

          request.resource.data.uploadedByUid ==
            resource.data.uploadedByUid &&

          request.resource.data.uploadedAt ==
            resource.data.uploadedAt
        );


      allow delete:
        if isPlatformAdmin();

    }


    /* =====================================================
       DEFAULT DENY

       EVERYTHING NOT EXPLICITLY OPENED ABOVE
       REMAINS DENIED.
    ===================================================== */

    match /{document=**} {

      allow read, write:
        if false;

    }

  }

}