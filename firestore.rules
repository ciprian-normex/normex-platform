rules_version = '2';

service cloud.firestore {

  match /databases/{database}/documents {


    /* =====================================================
       NORMEX PLATFORM
       SECURITY FOUNDATION

       accessLevel
       = authority band

       roleCode
       = functional role

       permissions
       = organisation-level capabilities

       project membership
       = project-specific scope/capabilities

       IMPORTANT

       Numeric level alone must NOT grant unrelated
       specialist management domains.

       Plant visibility/request capability may use the
       agreed authority bands.

       Plant management itself remains permission / role
       controlled.

       Level 99 remains the deliberate platform override.
    ===================================================== */


    /* =====================================================
       AUTH / PROFILE
    ===================================================== */

    function signedIn() {

      return request.auth != null;

    }


    function currentUserPath() {

      return /databases/$(database)/documents/users/$(request.auth.uid);

    }


    function currentProfileExists() {

      return signedIn() &&
        exists(
          currentUserPath()
        );

    }


    function currentProfile() {

      return get(
        currentUserPath()
      ).data;

    }


    function currentLevel() {

      return currentProfileExists()
        ? currentProfile().accessLevel
        : 0;

    }


    function currentOrganisationId() {

      return currentProfileExists()
        ? currentProfile().organisationId
        : "";

    }


    function currentRoleCode() {

      return currentProfileExists() &&
        currentProfile().keys().hasAny([
          "roleCode"
        ])
          ? currentProfile().roleCode
          : (
              currentProfileExists() &&
              currentProfile().keys().hasAny([
                "role"
              ])
                ? currentProfile().role
                : ""
            );

    }


    function isActiveUser() {

      return currentProfileExists() &&
        currentProfile().status == "ACTIVE";

    }


    function isPlatformAdmin() {

      return isActiveUser() &&
        currentLevel() >= 99;

    }


    /* =====================================================
       PERMISSION MAP HELPERS
    ===================================================== */

    function hasPermissionMap() {

      return currentProfileExists() &&
        currentProfile().keys().hasAny([
          "permissions"
        ]);

    }


    function canViewAllProjectsPermission() {

      return hasPermissionMap() &&

        currentProfile().permissions.keys().hasAny([
          "canViewAllProjects"
        ]) &&

        currentProfile().permissions.canViewAllProjects == true;

    }


    function canCreateProjectsPermission() {

      return hasPermissionMap() &&

        currentProfile().permissions.keys().hasAny([
          "canCreateProjects"
        ]) &&

        currentProfile().permissions.canCreateProjects == true;

    }


    function canManageOrganisationPermission() {

      return hasPermissionMap() &&

        currentProfile().permissions.keys().hasAny([
          "canManageOrganisation"
        ]) &&

        currentProfile().permissions.canManageOrganisation == true;

    }


    function canManageUsersPermission() {

      return hasPermissionMap() &&

        currentProfile().permissions.keys().hasAny([
          "canManageUsers"
        ]) &&

        currentProfile().permissions.canManageUsers == true;

    }


    function canManageAssurancePermission() {

      return hasPermissionMap() &&

        currentProfile().permissions.keys().hasAny([
          "canManageAssurance"
        ]) &&

        currentProfile().permissions.canManageAssurance == true;

    }


    function canViewCommercialPermission() {

      return hasPermissionMap() &&

        currentProfile().permissions.keys().hasAny([
          "canViewCommercial"
        ]) &&

        currentProfile().permissions.canViewCommercial == true;

    }


    function canManageCommercialPermission() {

      return hasPermissionMap() &&

        currentProfile().permissions.keys().hasAny([
          "canManageCommercial"
        ]) &&

        currentProfile().permissions.canManageCommercial == true;

    }


    function canViewPlantPermission() {

      return hasPermissionMap() &&

        currentProfile().permissions.keys().hasAny([
          "canViewPlant"
        ]) &&

        currentProfile().permissions.canViewPlant == true;

    }


    function canRequestPlantPermission() {

      return hasPermissionMap() &&

        currentProfile().permissions.keys().hasAny([
          "canRequestPlant"
        ]) &&

        currentProfile().permissions.canRequestPlant == true;

    }


    function canManagePlantPermission() {

      return hasPermissionMap() &&

        currentProfile().permissions.keys().hasAny([
          "canManagePlant"
        ]) &&

        currentProfile().permissions.canManagePlant == true;

    }


    function canManageTransportPermission() {

      return hasPermissionMap() &&

        currentProfile().permissions.keys().hasAny([
          "canManageTransport"
        ]) &&

        currentProfile().permissions.canManageTransport == true;

    }


    /* =====================================================
       ORGANISATION
    ===================================================== */

    function sameOrganisation(
      organisationId
    ) {

      return isPlatformAdmin() ||

        (
          isActiveUser() &&

          organisationId ==
            currentOrganisationId()
        );

    }


    /* =====================================================
       PLANT ROLE / ACCESS HELPERS
    ===================================================== */

    function isPlantTransportManager() {

      return isActiveUser() &&
        currentRoleCode() ==
          "PLANT_TRANSPORT_MANAGER";

    }


    function isOrganisationManager() {

      return isActiveUser() &&
        currentRoleCode() ==
          "ORGANISATION_MANAGER";

    }


    function canViewPlant(
      organisationId
    ) {

      return isPlatformAdmin() ||

        (
          sameOrganisation(
            organisationId
          ) &&

          (
            canViewPlantPermission() ||

            canRequestPlantPermission() ||

            canManagePlantPermission() ||

            canManageTransportPermission() ||

            isPlantTransportManager() ||

            isOrganisationManager() ||

            currentLevel() >= 1
          )
        );

    }


    function canRequestPlant(
      organisationId
    ) {

      return isPlatformAdmin() ||

        (
          sameOrganisation(
            organisationId
          ) &&

          (
            canRequestPlantPermission() ||

            canManagePlantPermission() ||

            canManageTransportPermission() ||

            isPlantTransportManager() ||

            isOrganisationManager() ||

            currentLevel() >= 2
          )
        );

    }


    function canManagePlant(
      organisationId
    ) {

      return isPlatformAdmin() ||

        (
          sameOrganisation(
            organisationId
          ) &&

          (
            canManagePlantPermission() ||

            canManageOrganisationPermission() ||

            isPlantTransportManager() ||

            isOrganisationManager()
          )
        );

    }


    function canManageTransport(
      organisationId
    ) {

      return isPlatformAdmin() ||

        (
          sameOrganisation(
            organisationId
          ) &&

          (
            canManageTransportPermission() ||

            canManagePlantPermission() ||

            canManageOrganisationPermission() ||

            isPlantTransportManager() ||

            isOrganisationManager()
          )
        );

    }


    function canViewPlantCosts(
      organisationId
    ) {

      return isPlatformAdmin() ||

        (
          sameOrganisation(
            organisationId
          ) &&

          (
            canViewCommercialPermission() ||

            canManageCommercialPermission() ||

            canManagePlantPermission() ||

            canManageTransportPermission() ||

            canManageOrganisationPermission() ||

            isPlantTransportManager() ||

            isOrganisationManager()
          )
        );

    }


    /* =====================================================
       PLANT ASSET V2 / COUNTER HELPERS
    ===================================================== */

    function validPlantAssetClass(data) {

      return data.keys().hasAll([
        "assetClass"
      ]) &&

        data.assetClass in [
          "ROAD_VEHICLE",
          "PLANT_MACHINERY",
          "SMALL_PLANT",
          "TRAILER_ATTACHMENT",
          "OTHER"
        ];

    }


    function validPlantAssetType(data) {

      return

        (
          data.assetClass == "ROAD_VEHICLE" &&

          data.keys().hasAll([
            "vehicleType",
            "registrationNumber",
            "manufacturer",
            "model"
          ]) &&

          data.vehicleType is string &&
          data.vehicleType.size() > 0 &&

          data.registrationNumber is string &&
          data.registrationNumber.size() > 0 &&

          data.manufacturer is string &&
          data.manufacturer.size() > 0 &&

          data.model is string &&
          data.model.size() > 0
        )

        ||

        (
          data.assetClass == "PLANT_MACHINERY" &&

          data.keys().hasAll([
            "plantType"
          ]) &&

          data.plantType is string &&
          data.plantType.size() > 0
        )

        ||

        (
          data.assetClass == "SMALL_PLANT" &&

          data.keys().hasAll([
            "equipmentType"
          ]) &&

          data.equipmentType is string &&
          data.equipmentType.size() > 0
        )

        ||

        (
          data.assetClass == "TRAILER_ATTACHMENT" &&

          data.keys().hasAll([
            "attachmentType"
          ]) &&

          data.attachmentType is string &&
          data.attachmentType.size() > 0
        )

        ||

        (
          data.assetClass == "OTHER" &&

          data.keys().hasAll([
            "otherAssetType"
          ]) &&

          data.otherAssetType is string &&
          data.otherAssetType.size() > 0
        );

    }


    function ownPlantCounterId(counterId) {

      return isActiveUser() &&

        canManagePlant(
          currentOrganisationId()
        ) &&

        counterId.matches(
          "^" +
          currentOrganisationId() +
          "_[A-Za-z0-9_-]+$"
        );

    }


    /* =====================================================
       PROJECT
    ===================================================== */

    function projectPath(
      projectId
    ) {

      return /databases/$(database)/documents/projects/$(projectId);

    }


    function projectExists(
      projectId
    ) {

      return exists(
        projectPath(
          projectId
        )
      );

    }


    function projectData(
      projectId
    ) {

      return get(
        projectPath(
          projectId
        )
      ).data;

    }


    function projectOrganisationMatches(
      projectId
    ) {

      return projectExists(
        projectId
      ) &&

      sameOrganisation(
        projectData(
          projectId
        ).organisationId
      );

    }


    /* =====================================================
       OPTIONAL PROJECT LINK

       Plant records may be organisation-wide and not yet
       assigned to a project.

       If projectId exists, it must belong to the same
       organisation.
    ===================================================== */

    function optionalProjectValid(
      data
    ) {

      return

        !data.keys().hasAny([
          "projectId"
        ])

        ||

        data.projectId == null

        ||

        data.projectId == ""

        ||

        (
          projectExists(
            data.projectId
          ) &&

          projectData(
            data.projectId
          ).organisationId ==
            data.organisationId
        );

    }


    /* =====================================================
       PROJECT MEMBERSHIP
    ===================================================== */

    function projectMemberPath(
      projectId
    ) {

      return /databases/$(database)/documents/projects/$(projectId)/members/$(request.auth.uid);

    }


    function projectMemberExists(
      projectId
    ) {

      return signedIn() &&

        exists(
          projectMemberPath(
            projectId
          )
        );

    }


    function projectMember(
      projectId
    ) {

      return get(
        projectMemberPath(
          projectId
        )
      ).data;

    }


    function isProjectMember(
      projectId
    ) {

      return projectMemberExists(
        projectId
      ) &&

      projectMember(
        projectId
      ).active == true;

    }


    function memberHasField(
      projectId,
      fieldName
    ) {

      return isProjectMember(
        projectId
      ) &&

      projectMember(
        projectId
      ).keys().hasAny([
        fieldName
      ]);

    }


    function projectMemberCanManage(
      projectId
    ) {

      return memberHasField(
        projectId,
        "canManageProject"
      ) &&

      projectMember(
        projectId
      ).canManageProject == true;

    }


    function projectMemberCanManageScopeProgress(
      projectId
    ) {

      return memberHasField(
        projectId,
        "canManageScopeProgress"
      ) &&

      projectMember(
        projectId
      ).canManageScopeProgress == true;

    }


    function projectMemberCanManageAssurance(
      projectId
    ) {

      return memberHasField(
        projectId,
        "canManageAssurance"
      ) &&

      projectMember(
        projectId
      ).canManageAssurance == true;

    }


    function projectMemberCanViewCommercial(
      projectId
    ) {

      return memberHasField(
        projectId,
        "canViewCommercial"
      ) &&

      projectMember(
        projectId
      ).canViewCommercial == true;

    }


    function projectMemberCanManageCommercial(
      projectId
    ) {

      return memberHasField(
        projectId,
        "canManageCommercial"
      ) &&

      projectMember(
        projectId
      ).canManageCommercial == true;

    }


    /* =====================================================
       PROJECT VISIBILITY
    ===================================================== */

    function canReadProject(
      projectId
    ) {

      return isPlatformAdmin() ||

        (
          isActiveUser() &&

          projectOrganisationMatches(
            projectId
          ) &&

          (
            canViewAllProjectsPermission() ||

            isProjectMember(
              projectId
            )
          )
        );

    }


    function canReadOptionalPlantProject(
      data
    ) {

      return canViewPlant(
        data.organisationId
      )

      ||

      (
        data.keys().hasAny([
          "projectId"
        ]) &&

        data.projectId != null &&

        data.projectId != "" &&

        canReadProject(
          data.projectId
        )
      );

    }


    /* =====================================================
       PROJECT MANAGEMENT
    ===================================================== */

    function canManageProject(
      projectId
    ) {

      return isPlatformAdmin() ||

        (
          isActiveUser() &&

          projectOrganisationMatches(
            projectId
          ) &&

          (
            canManageOrganisationPermission() ||

            projectMemberCanManage(
              projectId
            )
          )
        );

    }


    /* =====================================================
       ASSURANCE
    ===================================================== */

    function canManageAssurance(
      projectId
    ) {

      return isPlatformAdmin() ||

        (
          isActiveUser() &&

          projectOrganisationMatches(
            projectId
          ) &&

          (
            canManageAssurancePermission() ||

            projectMemberCanManageAssurance(
              projectId
            )
          )
        );

    }


    function canAccessPlantRequestProject(
      data
    ) {

      let actor = currentProfile();

      let permissions = actor.permissions;

      let roleCode = actor.roleCode;

      let managesRequests =
        actor.accessLevel >= 99 ||
        (permissions.keys().hasAny(["canManagePlant"]) && permissions.canManagePlant == true) ||
        (permissions.keys().hasAny(["canManageTransport"]) && permissions.canManageTransport == true) ||
        (permissions.keys().hasAny(["canManageOrganisation"]) && permissions.canManageOrganisation == true) ||
        roleCode == "PLANT_TRANSPORT_MANAGER" ||
        roleCode == "ORGANISATION_MANAGER";

      return signedIn() &&

        currentProfileExists() &&

        actor.status == "ACTIVE" &&

        data.keys().hasAll([
          "organisationId",
          "projectId"
        ]) &&

        data.projectId is string &&

        data.projectId != "" &&

        data.organisationId == actor.organisationId &&

        projectExists(
          data.projectId
        ) &&

        projectData(
          data.projectId
        ).organisationId == data.organisationId &&

        (
          managesRequests ||

          (permissions.keys().hasAny(["canViewAllProjects"]) && permissions.canViewAllProjects == true) ||

          isProjectMember(
            data.projectId
          )
        );

    }


    function canManagePlantRequests(
      organisationId
    ) {

      let actor = currentProfile();

      let permissions = actor.permissions;

      let roleCode = actor.roleCode;

      return signedIn() &&

        currentProfileExists() &&

        actor.status == "ACTIVE" &&

        organisationId == actor.organisationId &&

        (
          actor.accessLevel >= 99 ||

          (permissions.keys().hasAny(["canManagePlant"]) && permissions.canManagePlant == true) ||

          (permissions.keys().hasAny(["canManageTransport"]) && permissions.canManageTransport == true) ||

          (permissions.keys().hasAny(["canManageOrganisation"]) && permissions.canManageOrganisation == true) ||

          roleCode == "PLANT_TRANSPORT_MANAGER" ||

          roleCode == "ORGANISATION_MANAGER"
        );

    }


    function canCreatePlantRequest(
      data
    ) {

      let actor = currentProfile();

      let permissions = actor.permissions;

      let roleCode = actor.roleCode;

      let managesRequests =
        actor.accessLevel >= 99 ||
        (permissions.keys().hasAny(["canManagePlant"]) && permissions.canManagePlant == true) ||
        (permissions.keys().hasAny(["canManageTransport"]) && permissions.canManageTransport == true) ||
        (permissions.keys().hasAny(["canManageOrganisation"]) && permissions.canManageOrganisation == true) ||
        roleCode == "PLANT_TRANSPORT_MANAGER" ||
        roleCode == "ORGANISATION_MANAGER";

      return canAccessPlantRequestProject(data) &&

        (
          managesRequests ||

          (permissions.keys().hasAny(["canRequestPlant"]) && permissions.canRequestPlant == true) ||

          actor.accessLevel >= 2
        );

    }


    /* =====================================================
       COMMERCIAL
    ===================================================== */

    function canReadCommercial(
      projectId
    ) {

      return isPlatformAdmin() ||

        (
          isActiveUser() &&

          projectOrganisationMatches(
            projectId
          ) &&

          (
            canViewCommercialPermission() ||

            canManageCommercialPermission() ||

            projectMemberCanViewCommercial(
              projectId
            ) ||

            projectMemberCanManageCommercial(
              projectId
            )
          )
        );

    }


    function canManageCommercial(
      projectId
    ) {

      return isPlatformAdmin() ||

        (
          isActiveUser() &&

          projectOrganisationMatches(
            projectId
          ) &&

          (
            canManageCommercialPermission() ||

            projectMemberCanManageCommercial(
              projectId
            )
          )
        );

    }


    /* =====================================================
       USERS
    ===================================================== */

    match /users/{userId} {


      allow get: if
        signedIn() &&

        (
          request.auth.uid ==
            userId ||

          isPlatformAdmin() ||

          (
            sameOrganisation(
              resource.data.organisationId
            ) &&

            (
              canManageUsersPermission() ||

              canManageAssurancePermission()
            )
          )
        );


      allow list: if
        isPlatformAdmin() ||

        (
          isActiveUser() &&

          resource.data.organisationId ==
            currentOrganisationId() &&

          (
            canManageUsersPermission() ||

            canManageAssurancePermission()
          )
        );


      /*
       * Account lifecycle and authority mutations are performed only by the
       * trusted manageUserAccount callable. Admin SDK writes bypass rules.
       * A signed-in user retains a narrow contact/display-name self edit;
       * organisation, status and authority fields cannot be changed here.
       */
      allow create, delete: if false;

      allow update: if
        signedIn() &&
        request.auth.uid == userId &&
        resource.data.organisationId == currentOrganisationId() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "displayName",
          "phone",
          "updatedAt"
        ]);

    }


    /* =====================================================
       PEOPLE IDENTITY HANDOFF

       Admin creates/updates the minimal linked record through the trusted
       callable. Client access here is read-only and limited to authorised
       organisation account administrators for the Admin -> People handoff.
    ===================================================== */

    match /people/{personId} {

      allow read: if
        isPlatformAdmin() ||
        (
          isActiveUser() &&
          resource.data.organisationId == currentOrganisationId() &&
          canManageUsersPermission()
        );

      allow create, update, delete: if false;

    }


    /* =====================================================
       ORGANISATIONS
    ===================================================== */

    match /organisations/{organisationId} {


      allow read: if
        sameOrganisation(
          organisationId
        );


      allow create:
        if isPlatformAdmin();


      allow update: if
        isPlatformAdmin() ||

        (
          sameOrganisation(
            organisationId
          ) &&

          canManageOrganisationPermission()
        );


      allow delete:
        if isPlatformAdmin();

    }


    /* =====================================================
       SITES
    ===================================================== */

    match /sites/{siteId} {


      allow read: if
        isActiveUser() &&
        sameOrganisation(
          resource.data.organisationId
        );


      allow create: if
        (
          isPlatformAdmin() ||

          canManageOrganisationPermission()
        ) &&

        sameOrganisation(
          request.resource.data.organisationId
        );


      allow update: if
        (
          isPlatformAdmin() ||

          canManageOrganisationPermission()
        ) &&

        sameOrganisation(
          resource.data.organisationId
        ) &&

        request.resource.data.organisationId ==
          resource.data.organisationId;


      allow delete:
        if isPlatformAdmin();

    }


    /* =====================================================
       PROJECTS
    ===================================================== */

    match /projects/{projectId} {


      allow get: if
        isPlatformAdmin() ||

        (
          isActiveUser() &&

          sameOrganisation(
            resource.data.organisationId
          ) &&

          (
            canViewAllProjectsPermission() ||

            isProjectMember(
              projectId
            )
          )
        );


      allow list: if
        isPlatformAdmin() ||

        (
          isActiveUser() &&

          resource.data.organisationId ==
            currentOrganisationId() &&

          canViewAllProjectsPermission()
        );


      allow create: if
        (
          isPlatformAdmin() ||

          canCreateProjectsPermission() ||

          canManageOrganisationPermission()
        ) &&

        sameOrganisation(
          request.resource.data.organisationId
        ) &&

        request.resource.data.keys().hasAll([
          "organisationId",
          "projectCode",
          "name",
          "status",
          "rolesOnProject",
          "createdByUid",
          "createdAt",
          "updatedByUid",
          "updatedAt"
        ]) &&

        request.resource.data.name is string &&

        request.resource.data.projectCode is string &&

        request.resource.data.rolesOnProject is list &&

        request.resource.data.status in [
          "PRE_CONSTRUCTION",
          "LIVE",
          "ON_HOLD",
          "COMPLETE"
        ] &&

        request.resource.data.createdByUid ==
          request.auth.uid &&

        request.resource.data.updatedByUid ==
          request.auth.uid;


      allow update: if
        canManageProject(
          projectId
        ) &&

        request.resource.data.organisationId ==
          resource.data.organisationId &&

        request.resource.data.createdByUid ==
          resource.data.createdByUid &&

        request.resource.data.createdAt ==
          resource.data.createdAt;


      allow delete:
        if isPlatformAdmin();


      /* ===================================================
         MEMBERS
      =================================================== */

      match /members/{memberUid} {


        allow read: if
          canReadProject(
            projectId
          );


        allow create, update, delete: if
          isPlatformAdmin() ||

          (
            projectOrganisationMatches(
              projectId
            ) &&

            canManageOrganisationPermission()
          ) ||

          canManageProject(
            projectId
          );

      }


      /* ===================================================
         ACTIVITY
      =================================================== */

      match /activity/{activityId} {


        allow read: if
          canReadProject(
            projectId
          );


        allow create: if
          canReadProject(
            projectId
          ) &&

          request.resource.data.projectId ==
            projectId &&

          request.resource.data.organisationId ==
            projectData(
              projectId
            ).organisationId &&

          request.resource.data.createdByUid ==
            request.auth.uid;


        allow update, delete:
          if false;

      }

    }


    /* =====================================================
       PROJECT PHASES
    ===================================================== */

    match /projectPhases/{phaseId} {


      allow read: if
        canReadProject(
          resource.data.projectId
        );


      allow create: if
        canManageProject(
          request.resource.data.projectId
        ) &&

        request.resource.data.organisationId ==
          projectData(
            request.resource.data.projectId
          ).organisationId &&

        request.resource.data.createdByUid ==
          request.auth.uid;


      allow update: if
        canManageProject(
          resource.data.projectId
        ) &&

        request.resource.data.projectId ==
          resource.data.projectId &&

        request.resource.data.organisationId ==
          resource.data.organisationId &&

        request.resource.data.createdByUid ==
          resource.data.createdByUid &&

        request.resource.data.createdAt ==
          resource.data.createdAt;


      allow delete:
        if isPlatformAdmin();

    }


    /* =====================================================
       PROJECT SCOPES
    ===================================================== */

    match /projectScopes/{scopeId} {


      allow read: if
        canReadProject(
          resource.data.projectId
        );


      allow create: if
        canManageProject(
          request.resource.data.projectId
        ) &&

        request.resource.data.organisationId ==
          projectData(
            request.resource.data.projectId
          ).organisationId &&

        request.resource.data.createdByUid ==
          request.auth.uid;


      allow update: if

        (
          canManageProject(
            resource.data.projectId
          ) &&

          request.resource.data.projectId ==
            resource.data.projectId &&

          request.resource.data.organisationId ==
            resource.data.organisationId &&

          request.resource.data.createdByUid ==
            resource.data.createdByUid &&

          request.resource.data.createdAt ==
            resource.data.createdAt
        )

        ||

        (
          isActiveUser() &&

          projectOrganisationMatches(
            resource.data.projectId
          ) &&

          projectMemberCanManageScopeProgress(
            resource.data.projectId
          ) &&

          request.resource.data.diff(
            resource.data
          ).affectedKeys().hasOnly([
            "status",
            "actualStart",
            "actualFinish",
            "updatedByUid",
            "updatedAt"
          ]) &&

          request.resource.data.updatedByUid ==
            request.auth.uid
        );


      allow delete:
        if isPlatformAdmin();

    }


    /* =====================================================
       COMMERCIAL RECORDS
    ===================================================== */

    match /commercialRecords/{recordId} {


      allow read: if
        canReadCommercial(
          resource.data.projectId
        );


      allow create: if
        canManageCommercial(
          request.resource.data.projectId
        ) &&

        request.resource.data.organisationId ==
          projectData(
            request.resource.data.projectId
          ).organisationId &&

        request.resource.data.type in [
          "QUOTATION",
          "RFQ",
          "SUPPLIER_RFQ",
          "VARIATION_QUOTE",
          "VARIATION",
          "PURCHASE_ORDER",
          "OTHER"
        ] &&

        request.resource.data.createdByUid ==
          request.auth.uid;


      allow update: if
        canManageCommercial(
          resource.data.projectId
        ) &&

        request.resource.data.projectId ==
          resource.data.projectId &&

        request.resource.data.organisationId ==
          resource.data.organisationId &&

        request.resource.data.createdByUid ==
          resource.data.createdByUid &&

        request.resource.data.createdAt ==
          resource.data.createdAt;


      allow delete:
        if isPlatformAdmin();

    }


    /* =====================================================
       PLANT ASSETS

       Master asset identity.

       Existing read behaviour is intentionally preserved so
       Fleet / Overview organisation queries keep working.

       New creates use the Fleet V2 assetClass contract.
       Legacy existing Plant records remain update-compatible.
    ===================================================== */

    match /plantAssets/{plantId} {


      /*
       * Existing records:
       * preserve the known-working organisation read behaviour.
       *
       * Missing document GET:
       * Fleet allocation checks whether a candidate Asset ID
       * exists before creating it. An authorised Plant manager
       * may therefore GET a missing candidate document.
       */
      allow get: if

        (
          resource != null &&

          canViewPlant(
            resource.data.organisationId
          )
        )

        ||

        (
          resource == null &&

          isActiveUser() &&

          canManagePlant(
            currentOrganisationId()
          )
        );


      /*
       * Collection queries used by Fleet / Overview.
       * This is the old working read condition, kept deliberately.
       */
      allow list: if
        canViewPlant(
          resource.data.organisationId
        );


      allow create: if
        canManagePlant(
          request.resource.data.organisationId
        ) &&

        request.resource.data.organisationId ==
          currentOrganisationId() &&

        request.resource.data.keys().hasAll([
          "organisationId",
          "assetClass",
          "plantId",
          "plantReference",
          "ownershipType",
          "status",
          "active",
          "createdByUid",
          "createdAt",
          "updatedByUid",
          "updatedAt"
        ]) &&

        validPlantAssetClass(
          request.resource.data
        ) &&

        validPlantAssetType(
          request.resource.data
        ) &&

        request.resource.data.plantId ==
          plantId &&

        request.resource.data.plantReference ==
          plantId &&

        request.resource.data.createdByUid ==
          request.auth.uid &&

        request.resource.data.updatedByUid ==
          request.auth.uid;


      allow update: if
        canManagePlant(
          resource.data.organisationId
        ) &&

        request.resource.data.organisationId ==
          resource.data.organisationId &&

        request.resource.data.createdByUid ==
          resource.data.createdByUid &&

        request.resource.data.createdAt ==
          resource.data.createdAt &&

        (
          (
            request.resource.data.plantId ==
              resource.data.plantId &&

            request.resource.data.plantReference ==
              resource.data.plantReference
          )

          ||

          (
            !resource.data.keys().hasAny([
              "plantId"
            ]) &&

            request.resource.data.diff(
              resource.data
            ).affectedKeys().hasOnly([
              "complianceApplicability",
              "complianceHold",
              "complianceHoldReason",
              "complianceHoldHistory",
              "updatedByUid",
              "updatedByName",
              "updatedAt"
            ])
          )
        );


      allow delete:
        if isPlatformAdmin();

    }


    /* =====================================================
       PLANT COUNTERS

       Used to allocate readable Asset IDs.

       Example:
       colemans_VAN
       colemans_HRE
    ===================================================== */

    match /plantCounters/{counterId} {


      /*
       * Existing counter:
       * normal Plant-management authority.
       *
       * Missing counter:
       * Fleet must GET it before first creation. In that case
       * authorise only a same-organisation counter path.
       */
      allow get: if

        (
          resource != null &&

          canManagePlant(
            resource.data.organisationId
          )
        )

        ||

        (
          resource == null &&

          ownPlantCounterId(
            counterId
          )
        );


      /*
       * Counters are allocation internals and are never listed.
       */
      allow list:
        if false;


      allow create: if
        canManagePlant(
          request.resource.data.organisationId
        ) &&

        request.resource.data.organisationId ==
          currentOrganisationId() &&

        ownPlantCounterId(
          counterId
        ) &&

        request.resource.data.nextNumber is number;


      allow update: if
        canManagePlant(
          resource.data.organisationId
        ) &&

        request.resource.data.organisationId ==
          resource.data.organisationId &&

        ownPlantCounterId(
          counterId
        ) &&

        request.resource.data.nextNumber is number;


      allow delete:
        if isPlatformAdmin();

    }


    /* =====================================================
       PLANT HIRE RECORDS

       Contains commercially sensitive rates / charges.

       Read is deliberately narrower than general Fleet read.
    ===================================================== */

    match /plantHireRecords/{hireId} {


      allow read: if
        canViewPlantCosts(
          resource.data.organisationId
        );


      allow create: if
        canManagePlant(
          request.resource.data.organisationId
        ) &&

        request.resource.data.organisationId ==
          currentOrganisationId() &&

        request.resource.data.keys().hasAll([
          "organisationId",
          "plantId",
          "plantReference",
          "status",
          "createdByUid",
          "createdAt",
          "updatedByUid",
          "updatedAt"
        ]) &&

        request.resource.data.createdByUid ==
          request.auth.uid;


      allow update: if
        canManagePlant(
          resource.data.organisationId
        ) &&

        request.resource.data.organisationId ==
          resource.data.organisationId &&

        request.resource.data.plantId ==
          resource.data.plantId &&

        request.resource.data.plantReference ==
          resource.data.plantReference &&

        request.resource.data.createdByUid ==
          resource.data.createdByUid &&

        request.resource.data.createdAt ==
          resource.data.createdAt;


      allow delete:
        if isPlatformAdmin();

    }


    /* =====================================================
       PLANT ASSIGNMENTS

       Project commitment / deployment truth.
    ===================================================== */

    match /plantAssignments/{assignmentId} {


      allow read: if
        canReadOptionalPlantProject(
          resource.data
        );


      allow create: if
        canManagePlant(
          request.resource.data.organisationId
        ) &&

        optionalProjectValid(
          request.resource.data
        ) &&

        request.resource.data.createdByUid ==
          request.auth.uid;


      allow update: if
        canManagePlant(
          resource.data.organisationId
        ) &&

        request.resource.data.organisationId ==
          resource.data.organisationId &&

        request.resource.data.plantId ==
          resource.data.plantId &&

        optionalProjectValid(
          request.resource.data
        ) &&

        request.resource.data.createdByUid ==
          resource.data.createdByUid &&

        request.resource.data.createdAt ==
          resource.data.createdAt;


      allow delete:
        if isPlatformAdmin();

    }


    /* =====================================================
       PLANT MOVEMENTS

       Physical plant logistics / location evidence.
    ===================================================== */

    match /plantMovements/{movementId} {


      allow read: if
        canReadOptionalPlantProject(
          resource.data
        );


      allow create: if
        canManageTransport(
          request.resource.data.organisationId
        ) &&

        optionalProjectValid(
          request.resource.data
        ) &&

        request.resource.data.createdByUid ==
          request.auth.uid;


      allow update: if
        canManageTransport(
          resource.data.organisationId
        ) &&

        request.resource.data.organisationId ==
          resource.data.organisationId &&

        request.resource.data.plantId ==
          resource.data.plantId &&

        optionalProjectValid(
          request.resource.data
        ) &&

        request.resource.data.createdByUid ==
          resource.data.createdByUid &&

        request.resource.data.createdAt ==
          resource.data.createdAt;


      allow delete:
        if isPlatformAdmin();

    }


    /* =====================================================
       PLANT REQUESTS

       Intake, item review and canonical workflow handoff.

       L2+ / authorised users can submit.

       Plant management owns fulfilment / status control.
    ===================================================== */

    match /plantRequests/{requestId} {


      allow read: if

        canManagePlantRequests(
          resource.data.organisationId
        )

        ||

        (
          signedIn() &&

          sameOrganisation(
            resource.data.organisationId
          ) &&

          resource.data.createdByUid ==
            request.auth.uid
        )

        ||

        (
          resource.data.keys().hasAny([
            "projectId"
          ]) &&

          resource.data.projectId != null &&

          resource.data.projectId != "" &&

          canReadProject(
            resource.data.projectId
          )
        );


      allow create: if
        canCreatePlantRequest(
          request.resource.data
        ) &&

        request.resource.data.createdByUid ==
          request.auth.uid &&

        request.resource.data.requestType in [
          "PLANT_REQUIRED",
          "SERVICE_REPAIR",
          "MOVEMENT",
          "OFF_HIRE",
          "REPLACEMENT",
          "OTHER"
        ] &&

        request.resource.data.priority in [
          "NORMAL",
          "HIGH",
          "URGENT"
        ] &&

        request.resource.data.status in [
          "DRAFT",
          "SUBMITTED"
        ] &&

        request.resource.data.safetyCritical is bool &&

        request.resource.data.items is list;


      allow update: if
        (
          canManagePlantRequests(
            resource.data.organisationId
          )

          ||

          (
            signedIn() &&

            resource.data.createdByUid == request.auth.uid &&

            (
              (
                resource.data.status == "DRAFT" &&

                request.resource.data.status in [
                  "DRAFT",
                  "SUBMITTED"
                ]
              )

              ||

              (
                resource.data.status == "SUBMITTED" &&

                request.resource.data.status == "CANCELLED" &&

                request.resource.data.diff(
                  resource.data
                ).affectedKeys().hasOnly([
                  "status",
                  "items",
                  "cancelledAt",
                  "updatedByUid",
                  "updatedByName",
                  "updatedAt",
                  "history"
                ])
              )
            )
          )
        ) &&

        request.resource.data.organisationId ==
          resource.data.organisationId &&

        request.resource.data.createdByUid ==
          resource.data.createdByUid &&

        request.resource.data.createdAt ==
          resource.data.createdAt &&

        canAccessPlantRequestProject(
          request.resource.data
        ) &&

        request.resource.data.requestType in [
          "PLANT_REQUIRED",
          "SERVICE_REPAIR",
          "MOVEMENT",
          "OFF_HIRE",
          "REPLACEMENT",
          "OTHER"
        ] &&

        request.resource.data.priority in [
          "NORMAL",
          "HIGH",
          "URGENT"
        ] &&

        request.resource.data.safetyCritical is bool &&

        request.resource.data.items is list;


      allow delete:
        if isPlatformAdmin();

    }


    /* =====================================================
       PLANT ISSUES

       Operational exception-management layer.

       Examples:
       sourcing blocker
       breakdown delay
       part delay
       transport blocker
       replacement problem
       idle hire exposure
    ===================================================== */

    match /plantIssues/{issueId} {


      allow read: if
        canReadOptionalPlantProject(
          resource.data
        );


      allow create: if
        (
          canManagePlant(
            request.resource.data.organisationId
          )

          ||

          canManageTransport(
            request.resource.data.organisationId
          )
        ) &&

        optionalProjectValid(
          request.resource.data
        ) &&

        request.resource.data.createdByUid ==
          request.auth.uid;


      allow update: if
        (
          canManagePlant(
            resource.data.organisationId
          )

          ||

          canManageTransport(
            resource.data.organisationId
          )
        ) &&

        request.resource.data.organisationId ==
          resource.data.organisationId &&

        request.resource.data.createdByUid ==
          resource.data.createdByUid &&

        request.resource.data.createdAt ==
          resource.data.createdAt &&

        optionalProjectValid(
          request.resource.data
        );


      allow delete:
        if isPlatformAdmin();

    }


    /* =====================================================
       PLANT INSPECTIONS

       Operational inspection evidence.

       Project users may create inspection records against
       plant relevant to their project.

       Plant managers retain organisation-wide visibility.
    ===================================================== */

    match /plantInspections/{inspectionId} {


      allow read: if
        canReadOptionalPlantProject(
          resource.data
        );


      allow create: if
        isActiveUser() &&

        sameOrganisation(
          request.resource.data.organisationId
        ) &&

        optionalProjectValid(
          request.resource.data
        ) &&

        request.resource.data.createdByUid ==
          request.auth.uid &&

        (
          canViewPlant(
            request.resource.data.organisationId
          )

          ||

          (
            request.resource.data.keys().hasAny([
              "projectId"
            ]) &&

            request.resource.data.projectId != null &&

            request.resource.data.projectId != "" &&

            canReadProject(
              request.resource.data.projectId
            )
          )
        );


      allow update: if
        canManagePlant(
          resource.data.organisationId
        ) &&

        request.resource.data.organisationId ==
          resource.data.organisationId &&

        request.resource.data.plantId ==
          resource.data.plantId &&

        request.resource.data.createdByUid ==
          resource.data.createdByUid &&

        request.resource.data.createdAt ==
          resource.data.createdAt;


      allow delete:
        if isPlatformAdmin();

    }


    /* =====================================================
       PLANT DEFECTS

       Operational users may report defects.

       Plant management controls repair lifecycle.
    ===================================================== */

    match /plantDefects/{defectId} {


      allow read: if
        canReadOptionalPlantProject(
          resource.data
        );


      allow create: if
        isActiveUser() &&

        sameOrganisation(
          request.resource.data.organisationId
        ) &&

        optionalProjectValid(
          request.resource.data
        ) &&

        request.resource.data.createdByUid ==
          request.auth.uid &&

        (
          canViewPlant(
            request.resource.data.organisationId
          )

          ||

          (
            request.resource.data.keys().hasAny([
              "projectId"
            ]) &&

            request.resource.data.projectId != null &&

            request.resource.data.projectId != "" &&

            canReadProject(
              request.resource.data.projectId
            )
          )
        );


      allow update: if
        canManagePlant(
          resource.data.organisationId
        ) &&

        request.resource.data.organisationId ==
          resource.data.organisationId &&

        request.resource.data.plantId ==
          resource.data.plantId &&

        request.resource.data.createdByUid ==
          resource.data.createdByUid &&

        request.resource.data.createdAt ==
          resource.data.createdAt;


      allow delete:
        if isPlatformAdmin();

    }


    /* =====================================================
       PLANT MAINTENANCE
    ===================================================== */

    match /plantMaintenance/{maintenanceId} {


      allow read: if
        canViewPlant(
          resource.data.organisationId
        );


      allow create: if
        canManagePlant(
          request.resource.data.organisationId
        ) &&

        request.resource.data.organisationId ==
          currentOrganisationId() &&

        optionalProjectValid(
          request.resource.data
        ) &&

        request.resource.data.createdByUid ==
          request.auth.uid;


      allow update: if
        canManagePlant(
          resource.data.organisationId
        ) &&

        request.resource.data.organisationId ==
          resource.data.organisationId &&

        request.resource.data.plantId ==
          resource.data.plantId &&

        request.resource.data.createdByUid ==
          resource.data.createdByUid &&

        request.resource.data.createdAt ==
          resource.data.createdAt;


      allow delete:
        if isPlatformAdmin();

    }


    /* =====================================================
       PLANT SUPPLIERS
    ===================================================== */

    match /plantSuppliers/{supplierId} {


      allow read: if
        canViewPlant(
          resource.data.organisationId
        );


      allow create: if
        canManagePlant(
          request.resource.data.organisationId
        ) &&

        request.resource.data.organisationId ==
          currentOrganisationId() &&

        request.resource.data.createdByUid ==
          request.auth.uid;


      allow update: if
        canManagePlant(
          resource.data.organisationId
        ) &&

        request.resource.data.organisationId ==
          resource.data.organisationId &&

        request.resource.data.createdByUid ==
          resource.data.createdByUid &&

        request.resource.data.createdAt ==
          resource.data.createdAt;


      allow delete:
        if isPlatformAdmin();

    }


    /* =====================================================
       DOCUMENT HELPERS
    ===================================================== */

    function isPlantDocument(
      data
    ) {

      return data.keys().hasAny([
        "entityType"
      ]) &&

      data.keys().hasAny([
        "entityId"
      ]) &&

      data.entityType ==
        "PLANT";

    }


    function canReadPlantDocument(
      data
    ) {

      return isPlantDocument(
        data
      ) &&

      (
        data.category ==
          "COMMERCIAL"
          ? canViewPlantCosts(
              data.organisationId
            )
          : canViewPlant(
              data.organisationId
            )
      );

    }


    function canCreatePlantDocument(
      data
    ) {

      return isPlantDocument(
        data
      ) &&

      sameOrganisation(
        data.organisationId
      ) &&

      (
        canManagePlant(
          data.organisationId
        )

        ||

        (
          data.category ==
            "ASSURANCE" &&

          canManageAssurancePermission()
        )
      );

    }


    function canUpdatePlantDocument(
      data
    ) {

      return isPlantDocument(
        data
      ) &&

      sameOrganisation(
        data.organisationId
      ) &&

      (
        canManagePlant(
          data.organisationId
        )

        ||

        (
          data.category ==
            "ASSURANCE" &&

          canManageAssurancePermission()
        )
      );

    }


    /* =====================================================
       DOCUMENTS

       Supports BOTH:

       1. Project documents
       2. Plant-linked documents

       Plant records use:
       entityType = "PLANT"
       entityId   = Plant ID
    ===================================================== */

   match /documents/{documentId} {


  allow read: if

    isPlatformAdmin()

    ||

    canReadPlantDocument(
      resource.data
    )

    ||

        (
          !isPlantDocument(
            resource.data
          ) &&

          resource.data.category ==
            "COMMERCIAL" &&

          canReadCommercial(
            resource.data.projectId
          )
        )

        ||

        (
          !isPlantDocument(
            resource.data
          ) &&

          resource.data.category !=
            "COMMERCIAL" &&

          canReadProject(
            resource.data.projectId
          )
        );


      allow create: if

        (
          isPlantDocument(
            request.resource.data
          ) &&

          request.resource.data.keys().hasAll([
            "organisationId",
            "entityType",
            "entityId",
            "category",
            "documentType",
            "title",
            "storagePath",
            "fileName",
            "mimeType",
            "fileSize",
            "uploadedByUid",
            "uploadedAt"
          ]) &&

          request.resource.data.uploadedByUid ==
            request.auth.uid &&

          request.resource.data.category in [
            "PROJECT",
            "SCOPE",
            "COMMERCIAL",
            "ASSURANCE",
            "DRAWING",
            "PROGRAMME",
            "GENERAL",
            "PLANT",
            "HIRE",
            "CONDITION",
            "REPAIR",
            "TRANSPORT",
            "MANUAL"
          ] &&

          canCreatePlantDocument(
            request.resource.data
          )
        )

        ||

        (
          !isPlantDocument(
            request.resource.data
          ) &&

          request.resource.data.keys().hasAll([
            "organisationId",
            "projectId",
            "category",
            "documentType",
            "title",
            "storagePath",
            "fileName",
            "mimeType",
            "fileSize",
            "uploadedByUid",
            "uploadedAt"
          ]) &&

          request.resource.data.organisationId ==
            projectData(
              request.resource.data.projectId
            ).organisationId &&

          request.resource.data.uploadedByUid ==
            request.auth.uid &&

          request.resource.data.category in [
            "PROJECT",
            "SCOPE",
            "COMMERCIAL",
            "ASSURANCE",
            "DRAWING",
            "PROGRAMME",
            "GENERAL"
          ] &&

          (
            (
              request.resource.data.category ==
                "COMMERCIAL" &&

              canManageCommercial(
                request.resource.data.projectId
              )
            )

            ||

            (
              request.resource.data.category ==
                "ASSURANCE" &&

              canManageAssurance(
                request.resource.data.projectId
              )
            )

            ||

            (
              request.resource.data.category !=
                "COMMERCIAL" &&

              request.resource.data.category !=
                "ASSURANCE" &&

              canManageProject(
                request.resource.data.projectId
              )
            )
          )
        );


      allow update: if

        (
          isPlantDocument(
            resource.data
          ) &&

          canUpdatePlantDocument(
            resource.data
          ) &&

          request.resource.data.organisationId ==
            resource.data.organisationId &&

          request.resource.data.entityType ==
            resource.data.entityType &&

          request.resource.data.entityId ==
            resource.data.entityId &&

          request.resource.data.storagePath ==
            resource.data.storagePath &&

          request.resource.data.fileName ==
            resource.data.fileName &&

          request.resource.data.mimeType ==
            resource.data.mimeType &&

          request.resource.data.fileSize ==
            resource.data.fileSize &&

          request.resource.data.uploadedByUid ==
            resource.data.uploadedByUid &&

          request.resource.data.uploadedAt ==
            resource.data.uploadedAt
        )

        ||

        (
          !isPlantDocument(
            resource.data
          ) &&

          (
            (
              resource.data.category ==
                "COMMERCIAL" &&

              canManageCommercial(
                resource.data.projectId
              )
            )

            ||

            (
              resource.data.category ==
                "ASSURANCE" &&

              canManageAssurance(
                resource.data.projectId
              )
            )

            ||

            (
              resource.data.category !=
                "COMMERCIAL" &&

              resource.data.category !=
                "ASSURANCE" &&

              canManageProject(
                resource.data.projectId
              )
            )
          ) &&

          request.resource.data.organisationId ==
            resource.data.organisationId &&

          request.resource.data.projectId ==
            resource.data.projectId &&

          request.resource.data.category ==
            resource.data.category &&

          request.resource.data.storagePath ==
            resource.data.storagePath &&

          request.resource.data.fileName ==
            resource.data.fileName &&

          request.resource.data.mimeType ==
            resource.data.mimeType &&

          request.resource.data.fileSize ==
            resource.data.fileSize &&

          request.resource.data.uploadedByUid ==
            resource.data.uploadedByUid &&

          request.resource.data.uploadedAt ==
            resource.data.uploadedAt
        );


      allow delete:
        if isPlatformAdmin();

    }


    /* =====================================================
       PEOPLE ROTA

       Canonical collections:
       - peopleRotaWeeks: published pointer for an organisation/week
       - peopleRotaVersions: immutable version identity plus BUILDING -> PUBLISHED
       - peopleRotaEntries: immutable position records belonging to a version
    ===================================================== */

    function canManagePeopleRota() {

      return isPlatformAdmin() ||

        (
          isActiveUser() &&

          currentLevel() is number &&

          currentLevel() >= 3
        );

    }


    function canReadPeopleRota(
      data
    ) {

      return isPlatformAdmin() ||

        (
          isActiveUser() &&

          data.organisationId is string &&

          data.organisationId ==
            currentOrganisationId()
        );

    }


    function canReadPeopleRotaVersion(
      data
    ) {

      return isPlatformAdmin() ||

        (
          canReadPeopleRota(
            data
          ) &&

          data.status == "PUBLISHED"
        );

    }


    function canReadPeopleRotaEntry(
      data
    ) {

      return isPlatformAdmin() ||

        (
          canReadPeopleRota(
            data
          ) &&

          exists(
            /databases/$(database)/documents/peopleRotaVersions/$(data.versionId)
          ) &&

          get(
            /databases/$(database)/documents/peopleRotaVersions/$(data.versionId)
          ).data.organisationId == data.organisationId &&

          get(
            /databases/$(database)/documents/peopleRotaVersions/$(data.versionId)
          ).data.status == "PUBLISHED"
        );

    }


    function canWritePeopleRota(
      data
    ) {

      return canManagePeopleRota() &&

        currentOrganisationId() is string &&

        currentOrganisationId().size() > 0 &&

        data.organisationId is string &&

        data.organisationId ==
          currentOrganisationId();

    }


    function isPeopleRotaString(
      value,
      maximumLength
    ) {

      return value is string &&
        value.size() > 0 &&
        value.size() <= maximumLength;

    }


    function isPeopleRotaNullableString(
      value,
      maximumLength
    ) {

      return value == null ||
        isPeopleRotaString(
          value,
          maximumLength
        );

    }


    function isPeopleRotaDateKey(
      value
    ) {

      return value is string &&
        value.size() == 10 &&
        value.matches("^[0-9]{4}-[0-9]{2}-[0-9]{2}$");

    }


    function isValidPeopleRotaVersion(
      data
    ) {

      return data.keys().hasAll([
          "organisationId",
          "weekId",
          "weekStart",
          "versionNumber",
          "previousVersionId",
          "status",
          "entryCount",
          "createdByUid",
          "createdByName",
          "createdAt",
          "updatedByUid",
          "updatedAt"
        ]) &&

        data.keys().hasOnly([
          "organisationId",
          "weekId",
          "weekStart",
          "versionNumber",
          "previousVersionId",
          "status",
          "entryCount",
          "createdByUid",
          "createdByName",
          "createdAt",
          "updatedByUid",
          "updatedAt",
          "publishedByUid",
          "publishedByName",
          "publishedAt"
        ]) &&

        isPeopleRotaString(data.organisationId, 120) &&
        isPeopleRotaString(data.weekId, 180) &&
        isPeopleRotaDateKey(data.weekStart) &&
        data.versionNumber is int &&
        data.versionNumber > 0 &&
        data.versionNumber <= 1000000 &&
        isPeopleRotaNullableString(data.previousVersionId, 180) &&
        data.status in [
          "BUILDING",
          "PUBLISHED"
        ] &&
        data.entryCount is int &&
        data.entryCount >= 0 &&
        data.entryCount <= 10000 &&
        isPeopleRotaString(data.createdByUid, 128) &&
        isPeopleRotaString(data.createdByName, 160) &&
        data.createdAt is timestamp &&
        isPeopleRotaString(data.updatedByUid, 128) &&
        data.updatedAt is timestamp &&

        (
          (
            data.status == "BUILDING" &&
            !data.keys().hasAny([
              "publishedByUid",
              "publishedByName",
              "publishedAt"
            ])
          ) ||

          (
            data.status == "PUBLISHED" &&
            data.keys().hasAll([
              "publishedByUid",
              "publishedByName",
              "publishedAt"
            ]) &&
            isPeopleRotaString(data.publishedByUid, 128) &&
            isPeopleRotaString(data.publishedByName, 160) &&
            data.publishedAt is timestamp
          )
        );

    }


    function isValidPeopleRotaEntry(
      data
    ) {

      return data.keys().hasAll([
          "organisationId",
          "weekId",
          "versionId",
          "weekStart",
          "personId",
          "dateKey",
          "positionType",
          "projectId",
          "createdByUid",
          "createdAt"
        ]) &&

        data.keys().hasOnly([
          "organisationId",
          "weekId",
          "versionId",
          "weekStart",
          "personId",
          "dateKey",
          "positionType",
          "projectId",
          "createdByUid",
          "createdAt"
        ]) &&

        isPeopleRotaString(data.organisationId, 120) &&
        isPeopleRotaString(data.weekId, 180) &&
        isPeopleRotaString(data.versionId, 180) &&
        isPeopleRotaDateKey(data.weekStart) &&
        isPeopleRotaString(data.personId, 180) &&
        isPeopleRotaDateKey(data.dateKey) &&
        data.positionType in [
          "WORK",
          "HOLIDAY",
          "UNAVAILABLE"
        ] &&
        (
          (
            data.positionType == "WORK" &&
            isPeopleRotaString(data.projectId, 180)
          ) ||
          (
            data.positionType in [
              "HOLIDAY",
              "UNAVAILABLE"
            ] &&
            data.projectId == null
          )
        ) &&
        isPeopleRotaString(data.createdByUid, 128) &&
        data.createdAt is timestamp;

    }


    function peopleRotaEntryVersionExists(
      data
    ) {

      return exists(
          /databases/$(database)/documents/peopleRotaVersions/$(data.versionId)
        ) &&

        get(
          /databases/$(database)/documents/peopleRotaVersions/$(data.versionId)
        ).data.organisationId == data.organisationId &&

        get(
          /databases/$(database)/documents/peopleRotaVersions/$(data.versionId)
        ).data.weekId == data.weekId &&

        get(
          /databases/$(database)/documents/peopleRotaVersions/$(data.versionId)
        ).data.weekStart == data.weekStart &&

        get(
          /databases/$(database)/documents/peopleRotaVersions/$(data.versionId)
        ).data.status == "BUILDING";

    }


    function isValidPeopleRotaWeek(
      data
    ) {

      return data.keys().hasAll([
          "organisationId",
          "weekStart",
          "publishedVersionId",
          "publishedVersionNumber",
          "publishedByUid",
          "publishedByName",
          "publishedAt",
          "previousPublishedVersionId",
          "updatedByUid",
          "updatedAt"
        ]) &&

        data.keys().hasOnly([
          "organisationId",
          "weekStart",
          "publishedVersionId",
          "publishedVersionNumber",
          "publishedByUid",
          "publishedByName",
          "publishedAt",
          "previousPublishedVersionId",
          "updatedByUid",
          "updatedAt"
        ]) &&

        isPeopleRotaString(data.organisationId, 120) &&
        isPeopleRotaDateKey(data.weekStart) &&
        isPeopleRotaString(data.publishedVersionId, 180) &&
        data.publishedVersionNumber is int &&
        data.publishedVersionNumber > 0 &&
        data.publishedVersionNumber <= 1000000 &&
        isPeopleRotaString(data.publishedByUid, 128) &&
        isPeopleRotaString(data.publishedByName, 160) &&
        data.publishedAt is timestamp &&
        isPeopleRotaNullableString(data.previousPublishedVersionId, 180) &&
        isPeopleRotaString(data.updatedByUid, 128) &&
        data.updatedAt is timestamp;

    }


    function peopleRotaWeekPointsToPublishedVersion(
      data,
      weekId
    ) {

      return getAfter(
          /databases/$(database)/documents/peopleRotaVersions/$(data.publishedVersionId)
        ).data.organisationId == data.organisationId &&

        getAfter(
          /databases/$(database)/documents/peopleRotaVersions/$(data.publishedVersionId)
        ).data.weekId ==
          weekId &&

        getAfter(
          /databases/$(database)/documents/peopleRotaVersions/$(data.publishedVersionId)
        ).data.weekStart == data.weekStart &&

        getAfter(
          /databases/$(database)/documents/peopleRotaVersions/$(data.publishedVersionId)
        ).data.versionNumber == data.publishedVersionNumber &&

        getAfter(
          /databases/$(database)/documents/peopleRotaVersions/$(data.publishedVersionId)
        ).data.status == "PUBLISHED";

    }


    match /peopleRotaWeeks/{weekId} {

      allow get: if
        isPlatformAdmin() ||

        (
          isActiveUser() &&

          weekId.matches(
            "^" +
            currentOrganisationId() +
            "__[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          ) &&

          (
            resource == null ||

            resource.data.organisationId ==
              currentOrganisationId()
          )
        );


      allow list: if
        canReadPeopleRota(
          resource.data
        );


      allow create: if
        canWritePeopleRota(
          request.resource.data
        ) &&
        isValidPeopleRotaWeek(
          request.resource.data
        ) &&
        request.resource.data.previousPublishedVersionId == null &&
        request.resource.data.publishedVersionNumber == 1 &&
        request.resource.data.publishedByUid == request.auth.uid &&
        request.resource.data.updatedByUid == request.auth.uid &&
        request.resource.data.publishedAt == request.time &&
        request.resource.data.updatedAt == request.time &&
        peopleRotaWeekPointsToPublishedVersion(
          request.resource.data,
          weekId
        );


      allow update: if
        canWritePeopleRota(
          request.resource.data
        ) &&
        resource.data.organisationId ==
          currentOrganisationId() &&
        isValidPeopleRotaWeek(
          request.resource.data
        ) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "publishedVersionId",
          "publishedVersionNumber",
          "publishedByUid",
          "publishedByName",
          "publishedAt",
          "previousPublishedVersionId",
          "updatedByUid",
          "updatedAt"
        ]) &&
        request.resource.data.organisationId ==
          resource.data.organisationId &&
        request.resource.data.weekStart ==
          resource.data.weekStart &&
        request.resource.data.previousPublishedVersionId ==
          resource.data.publishedVersionId &&
        request.resource.data.publishedVersionNumber ==
          resource.data.publishedVersionNumber + 1 &&
        request.resource.data.publishedByUid == request.auth.uid &&
        request.resource.data.updatedByUid == request.auth.uid &&
        request.resource.data.publishedAt == request.time &&
        request.resource.data.updatedAt == request.time &&
        peopleRotaWeekPointsToPublishedVersion(
          request.resource.data,
          weekId
        );


      allow delete: if false;

    }


    match /peopleRotaVersions/{versionId} {

      allow read: if
        canReadPeopleRotaVersion(
          resource.data
        );


      allow create: if
        canWritePeopleRota(
          request.resource.data
        ) &&
        isValidPeopleRotaVersion(
          request.resource.data
        ) &&
        request.resource.data.status == "BUILDING" &&
        request.resource.data.createdByUid == request.auth.uid &&
        request.resource.data.updatedByUid == request.auth.uid &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.updatedAt == request.time;


      allow update: if
        canWritePeopleRota(
          request.resource.data
        ) &&
        resource.data.organisationId ==
          currentOrganisationId() &&
        isValidPeopleRotaVersion(
          request.resource.data
        ) &&
        resource.data.status == "BUILDING" &&
        request.resource.data.status == "PUBLISHED" &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "status",
          "publishedByUid",
          "publishedByName",
          "publishedAt",
          "updatedByUid",
          "updatedAt"
        ]) &&
        request.resource.data.organisationId ==
          resource.data.organisationId &&
        request.resource.data.weekId ==
          resource.data.weekId &&
        request.resource.data.weekStart ==
          resource.data.weekStart &&
        request.resource.data.versionNumber ==
          resource.data.versionNumber &&
        request.resource.data.publishedByUid == request.auth.uid &&
        request.resource.data.updatedByUid == request.auth.uid &&
        request.resource.data.publishedAt == request.time &&
        request.resource.data.updatedAt == request.time;


      allow delete: if false;

    }


    match /peopleRotaEntries/{entryId} {

      allow read: if
        canReadPeopleRotaEntry(
          resource.data
        );


      allow create: if
        canWritePeopleRota(
          request.resource.data
        ) &&
        isValidPeopleRotaEntry(
          request.resource.data
        ) &&
        request.resource.data.createdByUid == request.auth.uid &&
        request.resource.data.createdAt == request.time &&
        peopleRotaEntryVersionExists(
          request.resource.data
        );


      allow update, delete: if false;

    }


    /* =====================================================
       PEOPLE INDUCTION RECORDS

       All induction business operations run through the
       authenticated callable functions. Public certificate
       verification also uses an exact-ID callable that returns
       only safe fields. Direct browser access stays closed.
    ===================================================== */

    match /inductions/{inductionId} {
      allow read, write: if false;
    }

    match /inductionRequests/{requestId} {
      allow read, write: if false;
    }

    match /inductionSettings/{settingsId} {
      allow read, write: if false;
    }

    match /counters/inductions {
      allow read, write: if false;
    }


    /* =====================================================
       DEFAULT DENY

       EVERYTHING NOT EXPLICITLY OPENED ABOVE
       REMAINS DENIED.
    ===================================================== */

    match /{document=**} {

      allow read, write:
        if false;

    }

  }

}
