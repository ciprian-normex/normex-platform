{
  "firestore": {
    "database": "(default)",
    "location": "europe-west2",
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": {
    "source": "functions"
  },
  "hosting": {
     "public": ".",
    "ignore": [
      "firebase.json",
      "functions",
      "functions/**",
      "**/.*",
      "**/node_modules/**"
    ]
  },

 
  "storage": {
    "rules": "storage.rules"
  }
}
